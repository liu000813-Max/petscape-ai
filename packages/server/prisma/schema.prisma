// packages/server/prisma/schema.prisma
// spec: docs/plans/phase-b-execution-plan.md WP-2.3。
//
// 本包 schema 只含两类模型：
// 1. BasecampProbe —— 探针表，够跑 CRUD/事务/唯一约束冲突集成测试即可；
//    正式业务表从 WP-3.1 起逐包落地，不在本包提前建。
// 2. Better Auth 核心四表（User/Session/Account/Verification）—— 手写而非
//    `@better-auth/cli` 生成（该 CLI 版本落后于本仓库锁定的 better-auth 1.6.23，
//    参考 tracer/auth-tracer/prisma/schema.prisma 的现成字段集，仅把 provider
//    从 tracer 的 sqlite 换成本包的 postgresql）。本包验收范围仅是 adapter 初始化
//    冒烟 + migration 建表成功；OTP 登录闭环、手机号换绑等行为在 WP-3.1 落地。
//
// Prisma 7 + @prisma/adapter-pg driver adapter 路径（ADR-0002）：datasource 不设
// url（避免 Prisma CLI 默认查询引擎路径），运行时连接串通过 PrismaPg adapter 在
// src/infra/db/client.ts 中显式构造；CLI 侧连接串由 prisma.config.ts 提供。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BasecampProbe {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@map("basecamp_probe")
}

// ---- Better Auth 核心表（手写，字段集参考 tracer/auth-tracer） ----

model User {
  id            String  @id
  name          String?
  email         String? @unique
  emailVerified Boolean @default(false)
  image         String?

  // phone-number plugin fields（WP-3.1 起启用手机号 OTP 登录时消费）。
  phoneNumber         String? @unique
  phoneNumberVerified Boolean @default(false)
  role                String  @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // WP-3.2：Prisma 要求关系双向声明（Project.owner / Asset.owner 的反向字段）。
  projects              Project[]
  assets                Asset[]
  pets                  Pet[]
  customizationRequests CustomizationRequest[]
  roleChangesAsTarget   RoleChangeAudit[]      @relation("RoleChangeTarget")
  roleChangesAsActor    RoleChangeAudit[]      @relation("RoleChangeActor")
  reviewedCheckRuns     CheckRun[]
  modelConfirmations    ModelConfirmation[]
  sceneConfirmations    SceneConfirmation[]
  quotes                Quote[]
  deliveryAddresses     DeliveryAddress[]
  paymentIntents        PaymentIntent[]
  orders                Order[]
  orderStatusHistory    OrderStatusHistory[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---- WP-A3-2：OTP 发送节流记录（append-only） ----
// spec: docs/plans/p0-batch-1-execution-plan.md WP-A3-2 § S2 codex 审查增补（增补 d）。
//
// 独立于 Better Auth 的 Verification 表：Verification 记录会被验证消费
// （internalAdapter.consumeVerificationValue 删除该行），计数不可靠，无法承载
// "滚动 24 小时 N 次上限" 语义。本表只追加、不更新、不被验证流程删除，是节流判定的
// 唯一真相源。事务内原子判定「60s 冷却 + 滚动 24h 10 次上限」并插入一行；短信与邮件
// 两通道共用本表（按 channel 区分，target 为规范化后的手机号 E.164 或小写邮箱）。
// 记账时机：**发送成功后才最终保留**——通道抛错时删除刚插入的这一行（见
// application/otp-throttle.ts），因此计入上限的都是真实发出的验证码。
model OtpSendRecord {
  id      String   @id @default(cuid())
  // 规范化后的目标：邮箱=trim+lowercase，手机号=E.164（与 User.phoneNumber 同形）。
  target  String
  // 发送通道：'sms' | 'email'（两通道共用同一节流预算，按 target 聚合）。
  channel String
  sentAt  DateTime @default(now())

  // 节流查询走 (target, sentAt) 复合索引：按目标定位 + 按时间窗过滤。
  @@index([target, sentAt])
  @@map("otp_send_record")
}

// ---- WP-3.3 任务系统（ADR-0003：持久任务表 + SKIP LOCKED Worker） ----
// spec: docs/plans/phase-b-execution-plan.md WP-3.3 + docs/decisions/0003-persistent-jobs.md。
// 本阶段（测试先行）只落地表结构与接口签名占位，认领/续租/完成/失败等 SQL
// 实现留给后续两个并行 builder。

model Job {
  id String @id @default(cuid())

  type   String
  status String @default("pending") // pending|running|succeeded|failed|canceled|needs_attention

  ownerUserId String

  input Json

  // 业务幂等键：同一 (ownerUserId, type, idempotencyKey) 只允许一行，见下方唯一索引。
  idempotencyKey String

  // 防迟到覆盖令牌（ADR-0003 机制 3）：完成写入时必须匹配该版本，旧任务迟到完成不得覆盖新版本。
  targetVersion Int @default(1)

  attemptCount Int @default(0)
  maxAttempts  Int @default(3)

  // 租约（ADR-0003 机制 1）：认领时写入持有者与过期时间，周期心跳续租。
  leaseOwner     String?
  leaseExpiresAt DateTime?

  progress Json?

  // 错误分类（ADR-0003 机制 5）：retryable|permanent|canceled|manual。
  errorClass  String?
  errorDetail Json?

  // 供应商任务引用（ADR-0003 机制 2：孤儿恢复前必须先查供应商状态）。
  vendorTaskId String?

  resultRef Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  archivedAt DateTime?

  attempts JobAttempt[]
  quotes   Quote[]

  @@unique([ownerUserId, type, idempotencyKey], name: "job_owner_type_idempotency_key")
  @@index([status, leaseExpiresAt])
  @@map("job")
}

model JobAttempt {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  attemptNo Int
  workerId  String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  outcome String? // succeeded|failed|lost_lease|canceled 等，实现阶段收敛取值集合。
  error   Json?

  @@unique([jobId, attemptNo])
  @@map("job_attempt")
}

// ---- WP-3.2：持久项目 + 私有资产（OSS 小文件链） ----
// spec: docs/plans/phase-b-execution-plan.md WP-3.2；ADR-0005（对象存储）。
//
// Project 与 Asset 只记录归属、类型、大小、校验与 OSS 引用；二进制内容不进数据库
// （ADR-0005 背景："资产元数据、归属、版本和业务状态由关系型数据库拥有；对象存储
// 只保存二进制内容和必要对象属性"）。User 模型上的 `projects`/`assets` 反向字段
// 是 Prisma 强制要求（关系字段必须双向声明，否则 `prisma validate` 报错），并非
// 业务查询路径需要——授权判断走 domain 层的 assertOwner（按 ownerUserId 值比对），
// 不依赖 Prisma relation 反查。与并行改动 schema.prisma 加 Job 相关 model 的 agent
// 都会各自在 User model block 追加反向字段，冲突面由主控 merge 时处理。

enum ProjectStatus {
  editable
  archived
}

model Project {
  id          String        @id @default(cuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String?
  status      ProjectStatus @default(editable)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
  designItems DesignItem[]
  scene Scene?

  @@index([ownerUserId])
  @@map("project")
}

enum AssetStatus {
  pending
  available
}

model Asset {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Asset 的权限根永远是 ownerUserId。projectId 只是可选业务引用：Pet 封面等资产
  // 在 Project 创建前即可存在，删除 Project 也不应删除用户仍拥有的二进制资源。
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // 资产种类（WP-3.2 只产生 upload_raw；生成/切片产物种类留给后续包）。
  kind String

  mime     String
  size     Int
  checksum String?

  // ADR-0005：具体 key 必须包含不可猜测的资产标识；本包规则（ADR-0005 补充决定）：
  // uploads/raw/{ownerUserId}/{assetId}/{safe-filename}——见 infra/oss 与
  // application/assets.ts 的 key 构造。
  ossKey String @unique

  status AssetStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  petsWithCover Pet[] @relation("PetCoverAsset")

  @@index([ownerUserId])
  @@index([projectId])
  @@map("asset")
}

// ---- WP-B45-2：两阶段 Viewer 持久化与不可变确认 ----
// Scene 是每项目唯一的可编辑草稿；两类 Confirmation 只追加不更新。
model DesignItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String

  currentModelConfirmationId String?             @unique
  currentModelConfirmation   ModelConfirmation?  @relation("CurrentModelConfirmation", fields: [currentModelConfirmationId], references: [id], onDelete: SetNull)
  modelConfirmations         ModelConfirmation[] @relation("DesignItemConfirmations")
  scenes                     Scene[]              @relation("SceneTargetDesignItem")
  sceneConfirmations         SceneConfirmation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("design_item")
}

model ModelConfirmation {
  id           String     @id @default(cuid())
  designItemId String
  designItem   DesignItem @relation("DesignItemConfirmations", fields: [designItemId], references: [id], onDelete: Restrict)

  modelRef      Json
  sourceBoundsMm Json
  uniformScale  Float
  finalBoundsMm Json

  confirmedByUserId String
  confirmedBy       User   @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt       DateTime @default(now())

  currentForDesignItem DesignItem?         @relation("CurrentModelConfirmation")
  targetOfScenes       Scene[]              @relation("SceneTargetModelConfirmation")
  sceneConfirmations   SceneConfirmation[]

  @@index([designItemId, confirmedAt])
  @@index([confirmedByUserId])
  @@map("model_confirmation")
}

model Scene {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  targetDesignItemId       String
  targetDesignItem         DesignItem        @relation("SceneTargetDesignItem", fields: [targetDesignItemId], references: [id], onDelete: Restrict)
  targetModelConfirmationId String
  targetModelConfirmation   ModelConfirmation @relation("SceneTargetModelConfirmation", fields: [targetModelConfirmationId], references: [id], onDelete: Restrict)
  targetInstanceId          String

  cageMm   Json
  items    Json
  revision Int  @default(0)

  confirmations SceneConfirmation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([targetDesignItemId])
  @@index([targetModelConfirmationId])
  @@map("scene")
}

model SceneConfirmation {
  id            String @id @default(cuid())
  sceneId       String
  scene         Scene  @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  sceneRevision Int

  targetDesignItemId        String
  targetDesignItem          DesignItem        @relation(fields: [targetDesignItemId], references: [id], onDelete: Restrict)
  targetModelConfirmationId String
  targetModelConfirmation   ModelConfirmation @relation(fields: [targetModelConfirmationId], references: [id], onDelete: Restrict)
  targetInstanceId          String

  snapshotSchemaVersion String
  snapshot              Json
  confirmedByUserId     String
  confirmedBy           User     @relation(fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  confirmedAt           DateTime @default(now())

  @@unique([sceneId, sceneRevision])
  @@index([confirmedByUserId])
  @@index([targetDesignItemId])
  @@index([targetModelConfirmationId])
  @@map("scene_confirmation")
}

// ---- A4：宠物档案 ----
// Pet 是长期业务档案；照片仍归 User，Pet 只保留单封面 Asset 引用。
enum PetSpeciesCode {
  rat
  gecko
  snake
  parrot
  spider
  other
}

enum PetLifeStage {
  juvenile
  adult
  senior
  unknown
}

model Pet {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name              String
  speciesCode       PetSpeciesCode?
  customSpeciesName String?
  breed             String?
  sizeLevel         Int?
  lifeStage         PetLifeStage?
  behaviorTraits    String[]        @default([])
  environmentNotes  String?
  specialNeeds      String?

  coverAssetId String?
  coverAsset   Asset?  @relation("PetCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerUserId, deletedAt])
  @@index([coverAssetId])
  @@map("pet")
}

// ---- WP-B7-1：材料目录与版本化定价规则（append-only） ----
// 首版只 seed 不可售的沙箱材料/规则。更新参数必须新增版本，禁止原地改写；
// migration 以 PostgreSQL trigger 在数据库层拒绝 UPDATE/DELETE。
model Material {
  id                     String   @id
  versionCode            String   @unique
  displayName            String
  materialKind           String
  colorName              String
  densityMilligramPerCm3 Int
  unitPriceCentPerGram   Int
  currency               String
  isSellable             Boolean  @default(false)
  sandboxOnly            Boolean  @default(true)
  createdAt              DateTime @default(now())

  pricingRules PricingRule[]
  quotes       Quote[]

  @@map("material")
}

model PricingRule {
  id             String   @id
  versionCode    String   @unique
  materialId     String
  material       Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  formulaVersion String
  baseFeeCent    Int
  multiplier     Decimal  @db.Decimal(8, 4)
  floorPriceCent Int
  currency       String
  taxMode        String
  roundingMode   String
  isSellable     Boolean  @default(false)
  sandboxOnly    Boolean  @default(true)
  createdAt      DateTime @default(now())

  quotes Quote[]

  @@index([materialId])
  @@map("pricing_rule")
}

// ---- WP-C1-1：定制申请不可变版本 ----
// 客户端只提交 SceneConfirmation 引用与用户可编辑说明；场景、产品、材料和
// sandbox/live 资格由服务端解析后冻结。重提创建新行并把旧 submitted 行标为
// superseded，禁止原地覆盖历史输入。
model CustomizationRequest {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  sceneConfirmationId String
  projectId           String
  targetInstanceId    String
  sceneConfirmation   Json

  productCode     String
  materialName    String
  materialVersion String
  sandboxOnly     Boolean

  contactName            String
  contactPhone           String
  usageDescription       String
  additionalRequirements String?

  status             String
  idempotencyKey     String
  requestFingerprint String

  supersedesRequestId String?               @unique
  supersedesRequest   CustomizationRequest? @relation("CustomizationRequestSupersession", fields: [supersedesRequestId], references: [id], onDelete: Restrict)
  supersededByRequest CustomizationRequest? @relation("CustomizationRequestSupersession")
  checkRun            CheckRun?
  quotes              Quote[]
  orders              Order[]

  submittedAt DateTime
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([ownerUserId, idempotencyKey], map: "customization_request_owner_idempotency_key")
  @@index([ownerUserId, createdAt])
  @@index([sceneConfirmationId])
  @@map("customization_request")
}

// ---- WP-B6-0：窄用途角色授予审计 + 人工可信审核 ----
model RoleChangeAudit {
  id           String   @id @default(cuid())
  targetUserId String
  targetUser   User     @relation("RoleChangeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  actorUserId  String?
  actorUser    User?    @relation("RoleChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  previousRole String
  newRole      String
  source       String
  reason       String
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("role_change_audit")
}

model CheckRun {
  id        String               @id @default(cuid())
  requestId String               @unique
  request   CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  requestSnapshot       Json
  status                String
  result                String?
  issues                Json
  evidence              Json
  adjustmentSuggestions Json
  note                  String?

  reviewerUserId   String?
  reviewer         User?     @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  checklistVersion String
  ruleVersion      String
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  quotes Quote[]
  orders Order[]

  @@index([status, createdAt])
  @@index([reviewerUserId, status])
  @@map("check_run")
}

// ---- WP-C2-1：版本化 Quote 与单向生命周期 ----
// 金额、输入、审核、分析、材料和规则全部由服务端冻结。唯一合法更新是从 active
// 进入 accepted/expired/superseded/canceled；migration trigger 拒绝历史改写和删除。
model Quote {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  requestId     String
  request       CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  checkRunId    String
  checkRun      CheckRun             @relation(fields: [checkRunId], references: [id], onDelete: Restrict)
  estimateJobId String
  estimateJob   Job                  @relation(fields: [estimateJobId], references: [id], onDelete: Restrict)
  materialId    String
  material      Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  pricingRuleId String
  pricingRule   PricingRule          @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)

  quoteMode   String
  sandboxOnly Boolean
  status      String

  productCode        String
  materialName       String
  materialVersion    String
  pricingRuleVersion String
  inputSnapshot      Json
  priceBreakdown     Json
  deliveryEstimate   Json

  amountCent   Int
  currency     String
  taxMode      String
  roundingMode String

  idempotencyKey   String
  inputFingerprint String

  supersedesQuoteId String? @unique
  supersedesQuote   Quote?  @relation("QuoteSupersession", fields: [supersedesQuoteId], references: [id], onDelete: Restrict)
  supersededByQuote Quote?  @relation("QuoteSupersession")
  deliveryAddress   DeliveryAddress?
  paymentIntent     PaymentIntent?
  order             Order?

  validFrom    DateTime
  expiresAt    DateTime
  acceptedAt   DateTime?
  expiredAt    DateTime?
  supersededAt DateTime?
  canceledAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([ownerUserId, idempotencyKey], map: "quote_owner_idempotency_key")
  @@unique([ownerUserId, inputFingerprint], map: "quote_owner_input_fingerprint_key")
  @@index([ownerUserId, createdAt])
  @@index([requestId, status])
  @@index([status, expiresAt])
  @@map("quote")
}

// ---- WP-C5-1：当前结算地址与付款前确认 ----
// 每个 accepted Quote 至多一条地址。编辑使用 version CAS，并清除 confirmedAt；
// C3 只能消费重新确认后的服务端快照。Order 地址快照由后续 C4 独立冻结。
model DeliveryAddress {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quoteId     String @unique
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  recipientName String
  mobile        String
  province      String
  city          String
  district      String
  detail        String
  postalCode    String?

  sandboxOnly Boolean
  version     Int      @default(1)
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  paymentIntents PaymentIntent[]

  @@index([ownerUserId, updatedAt])
  @@index([ownerUserId, confirmedAt])
  @@map("delivery_address")
}

// ---- WP-C3-1：沙箱支付抽象、尝试与可信事件 ----
model PaymentProviderTrust {
  provider            String   @id
  verificationKeyHash String
  sandboxOnly         Boolean
  createdAt           DateTime @default(now())

  @@map("payment_provider_trust")
}

model PaymentIntent {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quoteId     String @unique
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  deliveryAddressId       String
  deliveryAddress         DeliveryAddress @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  deliveryAddressVersion  Int
  deliveryAddressSnapshot Json

  amountCent  Int
  currency    String
  mode        String
  provider    String
  sandboxOnly Boolean
  status      String

  idempotencyKey       String
  requestFingerprint   String
  verificationKeyHash String
  lastAppliedEventId   String?

  succeededAt      DateTime?
  failedAt         DateTime?
  canceledAt       DateTime?
  needsAttentionAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attempts PaymentAttempt[]
  events   PaymentEvent[]
  order    Order?

  @@unique([ownerUserId, idempotencyKey], map: "payment_intent_owner_idempotency_key")
  @@index([ownerUserId, createdAt])
  @@index([status, updatedAt])
  @@index([deliveryAddressId])
  @@map("payment_intent")
}

model PaymentAttempt {
  id                 String        @id @default(cuid())
  paymentIntentId    String
  paymentIntent      PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  attemptNo          Int
  provider           String
  providerPaymentId  String        @unique
  status                 String
  failureCode            String?
  failureMessage         String?
  providerObservedStatus String
  providerObservedAt     DateTime
  lastEventAt            DateTime?
  lastAppliedEventId     String?
  resolvedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  events PaymentEvent[]

  @@unique([paymentIntentId, attemptNo])
  @@index([paymentIntentId, status])
  @@map("payment_attempt")
}

model PaymentEvent {
  id                String         @id @default(cuid())
  sequence          BigInt         @unique @default(autoincrement())
  paymentIntentId   String
  paymentIntent     PaymentIntent  @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  paymentAttemptId  String
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  provider          String
  providerEventId   String         @unique
  providerPaymentId String
  source            String
  providerStatus    String
  verified          Boolean
  amountCent        Int
  currency          String
  occurredAt        DateTime
  sanitizedPayload  Json
  processingResult  String
  receivedAt        DateTime       @default(now())
  processedAt       DateTime

  @@index([paymentIntentId, receivedAt])
  @@index([paymentAttemptId, occurredAt])
  @@map("payment_event")
}

// ---- WP-C4-1：沙箱订单、不可变快照与可恢复补单 ----
// Order 只消费可信 succeeded PaymentIntent；同一 paymentIntentId 唯一。
// 数据库 trigger 校验金额、购买/审核/地址快照并自动写入初始状态历史。
model Order {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  paymentIntentId String        @unique
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  quoteId         String        @unique
  quote           Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  requestId       String
  request         CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  checkRunId      String
  checkRun        CheckRun      @relation(fields: [checkRunId], references: [id], onDelete: Restrict)

  status      String
  sandboxOnly Boolean
  amountCent  Int
  currency    String

  productCode        String
  materialName       String
  materialVersion    String
  pricingRuleVersion String
  purchaseSnapshot   Json
  deliveryAddressSnapshot Json

  paidAt   DateTime
  createdAt DateTime @default(now())

  history OrderStatusHistory[]

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@map("order")
}

model OrderStatusHistory {
  sequence BigInt @id @default(autoincrement())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  fromStatus String?
  toStatus   String
  reason     String
  source     String
  createdAt  DateTime @default(now())

  @@index([orderId, sequence])
  @@index([actorUserId, createdAt])
  @@map("order_status_history")
}
