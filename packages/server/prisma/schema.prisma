// packages/server/prisma/schema.prisma
// spec: docs/plans/phase-b-execution-plan.md WP-2.3。
//
// 本包 schema 只含两类模型：
// 1. BasecampProbe —— 探针表，够跑 CRUD/事务/唯一约束冲突集成测试即可；
//    正式业务表从 WP-3.1 起逐包落地，不在本包提前建。
// 2. Better Auth 核心四表（User/Session/Account/Verification）—— 手写而非
//    `@better-auth/cli` 生成（该 CLI 版本落后于本仓库锁定的 better-auth 1.6.23，
//    参考 tracer/auth-tracer/prisma/schema.prisma 的现成字段集，仅把 provider
//    从 tracer 的 sqlite 换成本包的 postgresql）。本包验收范围仅是 adapter 初始化
//    冒烟 + migration 建表成功；OTP 登录闭环、手机号换绑等行为在 WP-3.1 落地。
//
// Prisma 7 + @prisma/adapter-pg driver adapter 路径（ADR-0002）：datasource 不设
// url（避免 Prisma CLI 默认查询引擎路径），运行时连接串通过 PrismaPg adapter 在
// src/infra/db/client.ts 中显式构造；CLI 侧连接串由 prisma.config.ts 提供。

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BasecampProbe {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@map("basecamp_probe")
}

// ---- Better Auth 核心表（手写，字段集参考 tracer/auth-tracer） ----

model User {
  id            String   @id
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?

  // phone-number plugin fields（WP-3.1 起启用手机号 OTP 登录时消费）。
  phoneNumber         String?  @unique
  phoneNumberVerified Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // WP-3.2：Prisma 要求关系双向声明（Project.owner / Asset.owner 的反向字段）。
  projects Project[]
  assets   Asset[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---- WP-3.2：持久项目 + 私有资产（OSS 小文件链） ----
// spec: docs/plans/phase-b-execution-plan.md WP-3.2；ADR-0005（对象存储）。
//
// Project 与 Asset 只记录归属、类型、大小、校验与 OSS 引用；二进制内容不进数据库
// （ADR-0005 背景："资产元数据、归属、版本和业务状态由关系型数据库拥有；对象存储
// 只保存二进制内容和必要对象属性"）。User 模型上的 `projects`/`assets` 反向字段
// 是 Prisma 强制要求（关系字段必须双向声明，否则 `prisma validate` 报错），并非
// 业务查询路径需要——授权判断走 domain 层的 assertOwner（按 ownerUserId 值比对），
// 不依赖 Prisma relation 反查。与并行改动 schema.prisma 加 Job 相关 model 的 agent
// 都会各自在 User model block 追加反向字段，冲突面由主控 merge 时处理。

enum ProjectStatus {
  editable
  archived
}

model Project {
  id          String        @id @default(cuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String?
  status      ProjectStatus @default(editable)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@index([ownerUserId])
  @@map("project")
}

enum AssetStatus {
  pending
  available
}

model Asset {
  id          String      @id @default(cuid())
  ownerUserId String
  owner       User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 资产种类（WP-3.2 只产生 upload_raw；生成/切片产物种类留给后续包）。
  kind String

  mime     String
  size     Int
  checksum String?

  // ADR-0005：具体 key 必须包含不可猜测的资产标识；本包规则（ADR-0005 补充决定）：
  // uploads/raw/{ownerUserId}/{assetId}/{safe-filename}——见 infra/oss 与
  // application/assets.ts 的 key 构造。
  ossKey String @unique

  status AssetStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([projectId])
  @@map("asset")
}
