# Safe local defaults. Copy to .env; never commit real values.
NODE_ENV=development
BETTER_AUTH_SECRET=local-development-only-change-before-sharing-32chars
BETTER_AUTH_URL=http://localhost:3000
# 微信小程序登录桥（只配置在服务端，不要写进 miniapp 目录）
# WECHAT_MINIPROGRAM_APP_ID=wx-replace-me
# WECHAT_MINIPROGRAM_APP_SECRET=replace-me
SMS_CHANNEL=log
MAIL_CHANNEL=log
MAIL_FROM_ADDRESS=no-reply@example.invalid
PAYMENT_PROVIDER_MODE=disabled

# Full-stack local development (PostgreSQL 16)
DATABASE_URL=postgresql://petscape:petscape@127.0.0.1:5432/petscape?sslmode=disable
WEB_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5

# Optional object storage. Uncomment only when exercising upload/download flows.
# ALIBABA_CLOUD_REGION=example-region
# ALIBABA_CLOUD_ACCESS_KEY_ID=replace-me
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-me
# ALIBABA_CLOUD_OSS_BUCKET=replace-me
# ALIBABA_CLOUD_OSS_ENDPOINT=oss.example.invalid

# Optional paid generation providers. Uncomment locally; never commit real keys.
# FAL_KEY=replace-me
# MESHY_API_KEY=replace-me
# TRIPO_API_KEY=replace-me
# TRIPO_API_KEY_2=replace-me
# YUNWU_API_KEY=replace-me
# YUNWU_API_KEY_LOWRATE=replace-me
