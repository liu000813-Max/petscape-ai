# Safe local defaults. Copy to .env; never commit real values.
NODE_ENV=development
BETTER_AUTH_SECRET=local-development-only-change-before-sharing-32chars
BETTER_AUTH_URL=http://localhost:3000
SMS_CHANNEL=log
MAIL_CHANNEL=log
MAIL_FROM_ADDRESS=no-reply@example.invalid
PAYMENT_PROVIDER_MODE=disabled

# Full-stack local development (PostgreSQL 16)
DATABASE_URL=postgresql://petscape:petscape@127.0.0.1:5432/petscape?sslmode=disable
WEB_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5

# Optional object storage. Leave blank unless exercising upload/download flows.
ALIBABA_CLOUD_REGION=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_OSS_BUCKET=
ALIBABA_CLOUD_OSS_ENDPOINT=

# Optional paid generation providers. Never commit real keys.
FAL_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
TRIPO_API_KEY_2=
YUNWU_API_KEY=
YUNWU_API_KEY_LOWRATE=
