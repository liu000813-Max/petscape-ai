{
  "name": "petscape-final",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24.7.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter @petscape/worker dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter @petscape/server typecheck && pnpm --filter @petscape/worker typecheck",
    "lint": "pnpm --filter @petscape/server lint && pnpm --filter @petscape/worker lint && pnpm --filter web lint:baseline",
    "test": "pnpm --filter @petscape/server test && pnpm --filter web test",
    "validate:payment-recovery": "node scripts/validate-payment-recovery.mjs",
    "validate:docs": "node scripts/validate-docs.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@google/model-viewer>three": "0.185.1"
      }
    }
  }
}
