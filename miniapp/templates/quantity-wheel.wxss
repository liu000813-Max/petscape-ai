.quantity-picker { flex: 1; min-width: 0; }
.quantity-trigger { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid #ddd7d6; border-radius: 16rpx; background: #fcfbfa; }
.quantity-value { color: #171619; font-size: 30rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.quantity-placeholder, .quantity-suffix { color: #6d6869; font-size: 25rpx; }
.quantity-suffix { flex-shrink: 0; }
.quantity-chevron { margin-left: 6rpx; font-size: 28rpx; }
.weight-units { display: flex; flex-shrink: 0; width: 160rpx; padding: 6rpx; border-radius: 16rpx; background: #f3efed; }
.weight-units .unit-button { flex: 1; width: 72rpx; min-width: 0; margin: 0; padding: 8rpx 12rpx; border-radius: 12rpx; background: transparent; color: #716766; font-size: 26rpx; line-height: 1.7; }
.weight-units .unit-button.is-active { background: #050505; color: #fff; }
