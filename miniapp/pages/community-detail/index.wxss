.post-title { font-size: 44rpx; line-height: 1.3; }
.post-body { display: block; margin-top: 30rpx; white-space: pre-wrap; line-height: 1.8; }
.comment { display: flex; flex-direction: column; margin-bottom: 16rpx; }
.comment-body { margin-top: 12rpx; white-space: pre-wrap; line-height: 1.6; }
.post-gallery { position: relative; overflow: hidden; border-radius: 16rpx; background: #f7f3f5; }
.post-swiper { height: 510rpx; }
.post-photo { display: block; width: 100%; height: 100%; }
.post-photo-count { position: absolute; right: 12rpx; bottom: 12rpx; padding: 5rpx 16rpx; border-radius: 999rpx; background: #171515; color: #fff; font-size: 23rpx; pointer-events: none; }
