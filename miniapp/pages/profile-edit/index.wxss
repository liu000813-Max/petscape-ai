.profile-photo-section { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 34rpx; }
.profile-page .avatar-picker { position: relative; display: flex; align-items: center; justify-content: center; width: 170rpx; height: 170rpx; padding: 0; overflow: visible; border: 1rpx solid #eedee4; border-radius: 50%; background: #faedf2; }
.avatar-image { width: 100%; height: 100%; border-radius: 50%; }
.avatar-placeholder { width: 78rpx; height: 78rpx; }
.avatar-plus { position: absolute; right: -2rpx; bottom: 0; display: flex; align-items: center; justify-content: center; width: 47rpx; height: 47rpx; border: 4rpx solid white; border-radius: 50%; background: #050505; color: white; font-size: 29rpx; }
.profile-page .photo-link { width: auto; margin: 20rpx 0 0; padding: 10rpx; background: transparent; font-size: 25rpx; line-height: 1.5; }
.photo-hint { color: #888; font-size: 21rpx; }
.profile-page .wechat-avatar-button { width: auto; margin: 0 0 16rpx; padding: 10rpx 25rpx; border: 1rpx solid #e0e0e0; border-radius: 999rpx; background: #fff; color: #333; font-size: 24rpx; line-height: 1.6; }
.photo-actions { display: flex; gap: 26rpx; margin-top: 18rpx; }
.profile-page .photo-actions button { width: auto; margin: 0; padding: 5rpx 10rpx; background: transparent; color: #666; font-size: 23rpx; line-height: 1.5; }
.nickname-card { padding: 26rpx; border: 1rpx solid #e8e8e8; border-radius: 24rpx; }
.nickname-card .field-label { margin-top: 0; color: #333; }
.nickname-count { margin-top: 12rpx; text-align: right; color: #999; font-size: 21rpx; }
.profile-explanation { margin-top: 22rpx; color: #888; font-size: 23rpx; line-height: 1.7; }
.profile-notice { padding: 18rpx; margin-top: 24rpx; border-radius: 12rpx; background: #f8f3f5; color: #75515f; font-size: 24rpx; line-height: 1.7; }
.profile-page .primary-button { width: 100%; }
.profile-page { display: block; }
