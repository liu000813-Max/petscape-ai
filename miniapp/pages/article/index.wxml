<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取文章</view>
  <view wx:elif="{{error}}" class="error-state"><text>{{error}}</text><button class="secondary-button section" bindtap="loadArticle">重新读取</button></view>
  <view wx:else>
    <view class="article-header"><view><text class="badge official-badge">官方帖</text><text class="article-category">{{article.category}}</text></view><button class="article-star {{starred ? 'is-starred' : ''}}" bindtap="starArticle" aria-pressed="{{starred}}">{{starred ? '★ 已收藏' : '☆ 收藏'}}</button></view>
    <view class="title article-title">{{article.title}}</view><view class="subtitle">{{article.summary}}</view><text class="article-body">{{article.body}}</text>
  </view>
</view>
