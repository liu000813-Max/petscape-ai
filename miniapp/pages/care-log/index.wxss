@import "../../templates/quantity-wheel.wxss";

.form-card { display: flex; flex-direction: column; }
.field-label { margin-top: 22rpx; color: rgba(0,0,0,.55); font-size: 24rpx; }
.field-label:first-child { margin-top: 0; }
.picker-value, .input, .textarea { margin-top: 12rpx; padding: 20rpx; border: 1rpx solid rgba(0,0,0,.14); border-radius: 12rpx; background: #fff; }
.textarea { width: 100%; min-height: 180rpx; }
.log-card { display: flex; flex-direction: column; margin-bottom: 16rpx; }
.log-value { overflow-wrap: anywhere; }
.log-time { color: #655d61; font-size: 22rpx; }
.care-toolbar, .record-date-heading, .care-row-heading, .care-row-actions { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.care-toolbar { margin-top: 32rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eadfe4; }
.care-toolbar picker { flex: 1; min-width: 0; }
.pet-select { padding: 18rpx 0; font-weight: 650; overflow-wrap: anywhere; }
.care-toolbar .care-add { flex-shrink: 0; width: auto; margin: 0; padding: 0 24rpx; border-radius: 14rpx; background: #171515; color: #f4c1d3; font-size: 25rpx; line-height: 82rpx; }
.care-history-row { gap: 10rpx; margin: 0; padding: 22rpx 0 16rpx; border-bottom: 1rpx solid #eadfe4; }
.care-row-heading { flex-wrap: wrap; font-weight: 650; }
.care-row-actions { justify-content: flex-end; }
.care-row-actions .care-action, .form-card .care-action { width: auto; min-width: 80rpx; margin: 0; padding: 0 12rpx; background: transparent; color: #71354a; font-size: 25rpx; line-height: 70rpx; }
.care-row-actions .care-delete { color: #842849; }
.care-log-note { white-space: pre-wrap; overflow-wrap: anywhere; }
.care-preserved { margin-top: 8rpx; overflow-wrap: anywhere; }
.care-quantity-row { display: flex; align-items: center; gap: 18rpx; margin-top: 12rpx; }
.care-quantity-row .care-quantity-clear { flex-shrink: 0; width: auto; margin: 0; padding: 12rpx; background: transparent; color: #803c54; font-size: 24rpx; line-height: 2; }
