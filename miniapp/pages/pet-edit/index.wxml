<view class="page">
  <view class="eyebrow">PET PROFILE</view>
  <view class="title">{{isEdit ? '编辑档案' : '建立档案'}}</view>
  <view wx:if="{{loading}}" class="loading">正在读取档案</view>
  <view wx:else class="form-card card section">
    <view class="field">
      <text class="field-label">名字 · 必填</text>
      <input class="field-input" maxlength="80" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="例如：米粒" />
    </view>
    <view class="field">
      <text class="field-label">物种 · 必填</text>
      <picker mode="selector" range="{{speciesOptions}}" range-key="label" value="{{speciesIndex}}" bindchange="onSpeciesChange">
        <view class="picker-value">{{speciesOptions[speciesIndex].label}} <text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view wx:if="{{form.speciesCode === 'other'}}" class="field">
      <text class="field-label">具体物种 · 必填</text>
      <input class="field-input" maxlength="120" value="{{form.customSpeciesName}}" data-field="customSpeciesName" bindinput="onInput" placeholder="例如：刺猬、蜜袋鼯" />
    </view>
    <button wx:if="{{!isEdit}}" class="details-toggle" bindtap="toggleDetails" aria-expanded="{{showDetails}}" disabled="{{saving || choosingPhoto}}"><text>头像与更多资料 · 选填</text><text>{{showDetails ? '−' : '＋'}}</text></button>
    <block wx:if="{{showDetails || isEdit}}">
    <view class="photo-field">
      <image wx:if="{{photoPreview || speciesImage}}" class="photo-preview" src="{{photoPreview || speciesImage}}" mode="aspectFill" binderror="onPhotoError" />
      <view wx:else class="photo-placeholder">＋</view>
      <view class="photo-actions">
        <text class="field-label">宠物头像</text>
        <button class="photo-button" bindtap="choosePhoto" disabled="{{saving || choosingPhoto || loadFailed}}">{{choosingPhoto ? '正在编辑…' : '选图并裁切头像'}}</button>
        <text class="photo-hint">可拖动、缩放，调整头像范围</text>
        <text class="photo-hint">JPG / PNG / WebP · 最大 10 MB</text>
        <view wx:if="{{photoSelected}}" class="photo-edit-actions">
          <button class="photo-cancel" bindtap="recropPhoto" disabled="{{saving || choosingPhoto}}">重新裁切</button>
          <button class="photo-cancel" bindtap="cancelPhoto" disabled="{{saving || choosingPhoto}}">撤销选图</button>
        </view>
      </view>
    </view>
    <view wx:if="{{photoNotice}}" class="photo-notice">{{photoNotice}}</view>
    <view class="field">
      <text class="field-label">品种或补充说明</text>
      <input class="field-input" maxlength="40" value="{{form.breed}}" data-field="breed" bindinput="onInput" placeholder="例如：金丝雀或豹纹守宫" />
    </view>

    <view class="field">
      <text class="field-label">生命阶段</text>
      <picker mode="selector" range="{{lifeStageOptions}}" range-key="label" value="{{lifeStageIndex}}" bindchange="onLifeStageChange">
        <view class="picker-value">{{lifeStageOptions[lifeStageIndex].label}} <text class="picker-arrow">⌄</text></view>
      </picker>
      <view class="life-stage-reference"><text class="life-stage-species">参考物种：{{lifeStageReference.speciesName}}</text><text>{{lifeStageReference.note}}</text></view>
      <button class="source-button" bindtap="showStageSource">查看年龄参考依据</button>
      <view wx:if="{{lifeStageWarning}}" class="life-stage-warning">{{lifeStageWarning}}</view>
    </view>

    <view class="field">
      <text class="field-label">环境笔记</text>
      <textarea class="field-textarea" maxlength="300" value="{{form.environmentNotes}}" data-field="environmentNotes" bindinput="onInput" placeholder="温度、湿度、躲避空间或日常习惯" />
    </view>

    <view class="field">
      <text class="field-label">特殊需求</text>
      <textarea class="field-textarea" maxlength="300" value="{{form.specialNeeds}}" data-field="specialNeeds" bindinput="onInput" placeholder="需要特别留意的健康或照料事项" />
    </view>

    </block>
    <button class="primary-button submit-button" loading="{{saving}}" disabled="{{saving || choosingPhoto || loadFailed}}" bindtap="submit">保存档案</button>
  </view>
</view>
