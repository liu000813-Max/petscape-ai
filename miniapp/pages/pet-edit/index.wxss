.form-card {
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(0, 0, 0, 0.7);
  font-size: 24rpx;
  font-weight: 600;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-help {
  color: rgba(0, 0, 0, 0.55);
  font-size: 23rpx;
}

.field-input,
.picker-value,
.field-textarea {
  width: 100%;
  border: 1rpx solid rgba(0, 0, 0, 0.16);
  border-radius: 12rpx;
  background: #ffffff;
  color: #050505;
  font-size: 28rpx;
}

.field-input,
.picker-value {
  min-height: 82rpx;
  padding: 22rpx 24rpx;
}

.field-textarea {
  min-height: 150rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #050505;
  font-size: 34rpx;
}

.submit-button {
  margin-top: 10rpx;
}
