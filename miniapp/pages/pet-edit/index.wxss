.form-card {
  margin-bottom: 32rpx;
}

.photo-field { display: flex; align-items: center; gap: 26rpx; padding-bottom: 24rpx; }
.form-card .details-toggle { display: flex; justify-content: space-between; width: 100%; margin: 0 0 24rpx; padding: 16rpx 0; border-top: 1rpx solid #eee6e8; color: #55494e; background: transparent; font-size: 25rpx; line-height: 1.6; }
.photo-preview { width: 140rpx; height: 140rpx; border-radius: 50%; background: #f5f5f5; flex-shrink: 0; }
.photo-placeholder { width: 140rpx; height: 140rpx; border-radius: 50%; background: #f5f5f5; flex-shrink: 0; display: flex; justify-content: center; align-items: center; font-size: 48rpx; color: #777; }
.photo-actions { flex: 1; min-width: 0; }
.photo-button, .source-button, .photo-cancel { font-size: 24rpx; line-height: 1.5; padding: 12rpx 16rpx; margin: 8rpx 0; border-radius: 24rpx; background: #fff1f5; color: #171717; width: auto; }
.photo-hint { display: block; color: #777; font-size: 21rpx; }
.photo-cancel { display: inline-block; background: #f5f5f5; }
.photo-edit-actions { display: flex; flex-wrap: wrap; gap: 8rpx; }
.photo-notice { margin-bottom: 24rpx; font-size: 24rpx; color: #8b435b; line-height: 1.6; }
.source-button { display: inline-block; background: #f5f5f5; }

.field {
  margin-bottom: 30rpx;
}

.field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(0, 0, 0, 0.7);
  font-size: 24rpx;
  font-weight: 600;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-help {
  color: rgba(0, 0, 0, 0.55);
  font-size: 23rpx;
}

.field-input,
.picker-value,
.field-textarea {
  width: 100%;
  border: 1rpx solid rgba(0, 0, 0, 0.16);
  border-radius: 12rpx;
  background: #ffffff;
  color: #050505;
  font-size: 28rpx;
}

.field-input,
.picker-value {
  min-height: 82rpx;
  padding: 22rpx 24rpx;
}

.field-textarea {
  min-height: 150rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #050505;
  font-size: 34rpx;
}

.submit-button {
  margin-top: 10rpx;
}
.life-stage-reference { display: flex; flex-direction: column; margin-top: 16rpx; padding: 18rpx; border-radius: 12rpx; background: #faf7f8; color: #665c60; font-size: 23rpx; line-height: 1.65; }
.life-stage-species { margin-bottom: 6rpx; color: #463c40; }
.life-stage-warning { margin-top: 12rpx; color: #8b435b; font-size: 23rpx; line-height: 1.6; }
