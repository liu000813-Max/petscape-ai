<view class="page growth-editor">
  <view wx:if="{{loading}}" class="growth-status">正在读取宠物档案</view>
  <view wx:elif="{{loadError}}" class="growth-error">
    <text>{{loadError}}</text>
    <button class="growth-button" bindtap="loadPet">重试读取</button>
  </view>
  <form wx:elif="{{pet}}" bindsubmit="save">
    <text class="growth-pet-name">{{pet.name}}</text>
    <view class="growth-field">
      <view class="growth-field-heading"><text class="growth-label">照片</text><text class="growth-count">{{photos.length}} / 6</text></view>
      <view class="draft-grid">
        <view wx:for="{{photos}}" wx:key="path" class="draft-tile">
          <image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewPhoto" aria-label="预览照片" />
          <button class="remove-photo" data-path="{{item.path}}" catchtap="removePhoto" aria-label="移除照片"
            disabled="{{saving || choosing || uncertain || saved}}">×</button>
        </view>
        <button wx:if="{{photos.length < 6}}" class="draft-tile add-photo" bindtap="choosePhotos" disabled="{{saving || choosing || uncertain || saved}}">
          <text class="add-symbol">＋</text><text>添加照片</text>
        </button>
      </view>
    </view>
    <view class="growth-field">
      <text class="growth-label">照片日期</text>
      <picker mode="date" value="{{day}}" end="{{today}}" bindchange="onDay" disabled="{{saving || choosing || uncertain || saved}}">
        <view class="date-field"><text>{{day}}</text><text aria-hidden="true">›</text></view>
      </picker>
    </view>
    <view class="growth-field">
      <button class="note-toggle" bindtap="toggleNote" aria-expanded="{{showNote}}" disabled="{{saving || choosing || uncertain || saved}}">{{showNote ? '收起备注' : (note ? '编辑备注' : '＋ 添加备注')}}</button>
      <block wx:if="{{showNote}}">
      <textarea class="note-field" name="note" value="{{note}}" maxlength="2000" placeholder="给照片留一句话" bindinput="onNote"
        disabled="{{saving || choosing || uncertain || saved}}" aria-label="照片备注" />
      </block>
    </view>
    <text wx:if="{{notice}}" class="growth-notice" aria-live="polite">{{notice}}</text>
    <button wx:if="{{uncertain}}" class="growth-button save-button" bindtap="retrySave" loading="{{saving}}" disabled="{{saving}}">重试保存</button>
    <button wx:else class="growth-button save-button" form-type="submit" loading="{{saving}}" disabled="{{saving || choosing || saved || !photos.length}}">{{saved ? '已保存' : '保存照片'}}</button>
  </form>
</view>
