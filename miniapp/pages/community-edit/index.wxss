.page.note-editor { padding-top: 20rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.note-editor button { margin: 0; }
.note-photo-header, .note-topic, .note-draft { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.note-photo-header { margin-bottom: 12rpx; }
.note-label { font-size: 30rpx; font-weight: 700; }
.note-count { margin-left: 8rpx; color: #666064; font-size: 23rpx; font-weight: 400; }
.note-editor .note-link { width: auto; min-height: 72rpx; padding: 0 8rpx; background: transparent; color: #73364b; font-size: 25rpx; line-height: 72rpx; }
.note-photo-scroll { width: 100%; }
.note-photo-row { display: inline-flex; gap: 12rpx; padding-bottom: 12rpx; }
.note-photo { width: 252rpx; flex: 0 0 252rpx; }
.note-editor .note-thumbnail { position: relative; display: flex; justify-content: center; align-items: center; width: 100%; height: 204rpx; padding: 0; overflow: hidden; border-radius: 16rpx; background: #f3eef0; color: #62595e; font-size: 24rpx; }
.note-thumbnail image { display: block; width: 100%; height: 100%; }
.note-photo-index { position: absolute; left: 10rpx; bottom: 10rpx; padding: 3rpx 12rpx; border-radius: 10rpx; background: #171515; color: #fff; font-size: 21rpx; line-height: 1.45; }
.note-photo:first-child .note-photo-index { background: #f4c1d3; color: #171515; }
.note-photo-actions { display: flex; justify-content: space-between; gap: 4rpx; margin-top: 5rpx; }
.note-editor .note-photo-actions button { flex: 1; width: auto; min-height: 64rpx; padding: 0; background: #f8f4f5; color: #30262a; border-radius: 8rpx; font-size: 30rpx; line-height: 64rpx; }
.note-editor button[disabled] { opacity: .5; }
.note-title { width: 100%; min-height: 94rpx; margin-top: 10rpx; border-top: 1rpx solid #eee5e9; border-bottom: 1rpx solid #eee5e9; font-size: 36rpx; font-weight: 700; }
.note-body { display: block; width: 100%; height: 260rpx; padding: 22rpx 0; font-size: 29rpx; line-height: 1.6; }
.note-topic { flex-wrap: wrap; min-height: 82rpx; padding: 0 14rpx; border-top: 1rpx solid #eee5e9; border-bottom: 1rpx solid #eee5e9; color: #73364b; font-size: 27rpx; }
.note-topic > text:first-child { color: #242025; font-weight: 600; }
.note-notice { margin-top: 20rpx; color: #73364b; font-size: 25rpx; line-height: 1.5; }
.note-footer { margin-top: 28rpx; }
.note-footer .primary-button { width: 100%; }
.note-draft { flex-wrap: wrap; margin: 8rpx 0; }
