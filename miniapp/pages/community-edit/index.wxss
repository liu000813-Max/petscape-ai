.form-card { display: flex; flex-direction: column; }
.field-label { margin-top: 22rpx; color: rgba(0,0,0,.55); font-size: 24rpx; }
.field-label:first-child { margin-top: 0; }
.picker-value, .input, .textarea { margin-top: 12rpx; padding: 20rpx; border: 1rpx solid rgba(0,0,0,.14); border-radius: 12rpx; background: #fff; }
.textarea { width: 100%; min-height: 300rpx; }
