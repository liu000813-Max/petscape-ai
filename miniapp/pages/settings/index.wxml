<view class="page settings-page">
  <view class="eyebrow">PREFERENCES</view><view class="title">设置</view><view class="subtitle">管理权限，了解你的资料。</view>
  <view class="section"><view class="settings-group-label">权限与资料</view>
    <view class="settings-group">
      <button class="settings-row" bindtap="openPermissions"><view class="setting-mark"><image src="/assets/nav-permission-black.png" mode="aspectFit" /></view><view class="setting-copy"><text class="setting-title">微信权限</text><text class="setting-note">查看与调整已授权的权限</text></view><text class="setting-arrow">›</text></button>
      <button class="settings-row" bindtap="refreshData" disabled="{{refreshing}}"><view class="setting-mark"><image src="/assets/nav-refresh-black.png" mode="aspectFit" /></view><view class="setting-copy"><text class="setting-title">{{refreshing ? '正在刷新…' : '刷新宠物资料'}}</text><text class="setting-note">重新读取，不删除已有记录</text></view><text class="setting-arrow">↻</text></button>
    </view>
    <view wx:if="{{refreshNotice}}" class="refresh-result">{{refreshNotice}}</view>
    <view wx:if="{{loadError}}" class="settings-error"><view>{{loadErrorTitle}}</view><view>{{loadError}}</view><view class="error-detail">{{loadErrorDetail}}</view></view>
  </view>
  <view class="section"><view class="settings-group-label">了解 PETSCAPE</view>
    <view class="settings-group">
      <button class="settings-row" bindtap="openGuide"><view class="setting-mark"><image src="/assets/nav-paw-black.png" mode="aspectFit" /></view><view class="setting-copy"><text class="setting-title">使用引导</text><text class="setting-note">重看宠物档案与日常记录介绍</text></view><text class="setting-arrow">›</text></button>
      <button class="settings-row" bindtap="showDataInfo"><view class="setting-mark"><image src="/assets/nav-book-black.png" mode="aspectFit" /></view><view class="setting-copy"><text class="setting-title">数据与隐私说明</text><text class="setting-note">资料保存与权限使用说明</text></view><text class="setting-arrow">›</text></button>
      <button class="settings-row" bindtap="showAbout"><view class="setting-mark"><image src="/assets/nav-paw-black.png" mode="aspectFit" /></view><view class="setting-copy"><text class="setting-title">关于 PETSCAPE</text><text class="setting-note">给每一位伙伴，合适的宠境</text></view><text class="setting-arrow">›</text></button>
    </view>
  </view>
  <view class="settings-footer"><image src="/assets/petscape-logo.png" mode="aspectFit" /><view>{{accountLabel}} · {{versionLabel}}</view><view>让陪伴有迹可循</view></view>
</view>
