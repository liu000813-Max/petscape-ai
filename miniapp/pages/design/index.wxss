.start-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 260rpx;
  margin-top: 34rpx;
  padding: 32rpx;
  border-radius: 22rpx;
  background: #050505;
  color: #ffffff;
}

.start-card text {
  display: block;
}

.start-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.start-title {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.start-note {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  line-height: 1.5;
}

.start-arrow {
  font-size: 54rpx;
}

.project-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.project-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #f7f7f5;
  color: #050505;
  font-size: 36rpx;
}

.project-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.project-title {
  font-size: 29rpx;
  font-weight: 700;
}

.project-main .muted {
  margin-top: 6rpx;
}

.design-note {
  display: flex;
  flex-direction: column;
}

.note-title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.design-note .muted {
  margin-top: 10rpx;
  line-height: 1.55;
}
