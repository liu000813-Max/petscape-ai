<view class="page tab-page">
  <view class="community-head">
    <view class="title">宠物社区</view>
    <button class="compose-button" bindtap="createPost">＋ 发帖</button>
  </view>
  <view class="community-sections">
    <button wx:for="{{sections}}" wx:key="id" class="community-section {{section === item.id ? 'selected' : ''}}" data-section="{{item.id}}" bindtap="selectSection" aria-pressed="{{section === item.id}}">{{item.label}}</button>
  </view>

  <block wx:if="{{section === 'community'}}">
  <scroll-view class="topic-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="topic-row">
      <view wx:for="{{topics}}" wx:key="*this" class="topic {{active === item ? 'selected' : ''}}" data-topic="{{item}}" bindtap="selectTopic">{{topicLabels[index]}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading">正在读取社区动态</view>
  <view wx:elif="{{error}}" class="error-state"><text>{{error}}</text><button class="secondary-button" bindtap="loadSection">重新读取</button></view>
  <view wx:elif="{{posts.length}}" class="section post-list">
    <view wx:for="{{posts}}" wx:key="id" wx:if="{{active === '全部' || active === item.tag}}" class="post-card card" data-id="{{item.id}}" bindtap="openPost">
      <image wx:if="{{item.coverUrl}}" class="post-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="post-tag badge">{{item.topicLabel}}</view>
      <text class="post-title">{{item.title}}</text>
      <view class="post-meta"><text>{{item.author}}</text><text>{{item.time}}</text></view>
      <view class="post-stats"><text data-id="{{item.id}}" catchtap="likePost">{{item.liked ? '♥' : '♡'}} {{item.likes}}</text><text>评论 {{item.comments}}</text></view>
    </view>
  </view>
  <view wx:else class="empty card section">还没有公开动态</view>
  <view class="section"><button class="secondary-button" bindtap="openServices">查看同城服务</button></view>
  </block>
  <block wx:elif="{{section === 'mine'}}">
    <view class="submission-toolbar">
      <button class="submission-refresh" bindtap="refreshMyPosts" disabled="{{myPostsLoading}}">刷新状态</button>
    </view>
    <view wx:if="{{myPosts.length}}" class="section post-list">
      <view wx:for="{{myPosts}}" wx:key="id" class="post-card submission-card card">
        <button class="submission-toggle" data-id="{{item.id}}" bindtap="toggleSubmission"
          aria-expanded="{{expandedPostId === item.id}}">
          <view class="submission-meta">
            <text class="submission-status {{item.status}}">{{item.statusLabel}}</text>
            <text class="submission-date">{{item.dateLabel}}</text>
          </view>
          <text class="post-title">{{item.title}}</text>
          <view class="submission-topic"><text>{{item.topicLabel}}{{item.photoCount ? ' · ' + item.photoCount + ' 张照片' : ''}}</text><text aria-hidden="true">{{expandedPostId === item.id ? '收起 ⌃' : '展开 ⌄'}}</text></view>
        </button>
        <text wx:if="{{expandedPostId === item.id}}" class="submission-body" user-select>{{item.body}}</text>
      </view>
    </view>
    <view wx:if="{{myPostsLoading && !myPosts.length}}" class="loading">正在读取投稿</view>
    <view wx:elif="{{myPostsError}}" class="error-state">
      <text>{{myPostsError}}</text>
      <button wx:if="{{nextPostOffset !== null}}" class="secondary-button" bindtap="loadMoreMyPosts">重新加载</button>
      <button wx:else class="secondary-button" bindtap="loadSection">重新读取</button>
    </view>
    <view wx:elif="{{!myPosts.length}}" class="empty card section">还没有投稿</view>
    <button wx:elif="{{nextPostOffset !== null}}" class="secondary-button" bindtap="loadMoreMyPosts" loading="{{myPostsLoading}}" disabled="{{myPostsLoading}}">加载更多投稿</button>
  </block>
  <block wx:else>
    <scroll-view wx:if="{{section === 'official'}}" class="topic-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="topic-row">
        <button wx:for="{{categories}}" wx:key="*this" class="topic category-button {{category === item ? 'selected' : ''}}" data-category="{{item}}" bindtap="selectCategory" aria-pressed="{{category === item}}">{{item}}</button>
      </view>
    </scroll-view>
    <view wx:if="{{articlesLoading}}" class="loading">正在读取官方帖</view>
    <view wx:elif="{{articlesError}}" class="error-state"><text>{{articlesError}}</text><button class="secondary-button" bindtap="loadSection">重新读取</button></view>
    <view wx:elif="{{articles.length}}" class="section post-list">
      <view wx:for="{{articles}}" wx:key="id" class="post-card official-card card" data-id="{{item.id}}" bindtap="openArticle">
        <view class="official-header">
          <view class="official-tags"><text class="badge official-badge">官方帖</text><text class="official-category">{{item.category}}</text></view>
          <button class="star-button {{item.starred ? 'is-starred' : ''}}" data-id="{{item.id}}" catchtap="starArticle" aria-label="{{item.starred ? '取消收藏' : '收藏'}}{{item.title}}" aria-pressed="{{item.starred}}">{{item.starred ? '★' : '☆'}}</button>
        </view>
        <text class="post-title">{{item.title}}</text>
        <text wx:if="{{item.summary}}" class="official-summary">{{item.summary}}</text>
      </view>
    </view>
    <view wx:else class="empty card section">
      <text>{{section === 'saved' ? '暂无可查看的收藏' : '这个分类暂时没有官方帖'}}</text>
      <button wx:if="{{section === 'saved'}}" class="secondary-button section" data-section="official" bindtap="selectSection">浏览官方帖</button>
    </view>
  </block>
</view>
