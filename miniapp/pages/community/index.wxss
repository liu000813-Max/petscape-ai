.community-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.community-head .title {
  margin: 0;
  font-weight: 700;
}

.community-head .compose-button {
  width: auto;
  min-width: 142rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #050505;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 68rpx;
}

.topic-scroll {
  width: 100%;
  margin-top: 34rpx;
}

.topic-row {
  display: flex;
  gap: 14rpx;
  width: max-content;
}

.topic {
  padding: 14rpx 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.16);
  border-radius: 999rpx;
  color: rgba(0, 0, 0, 0.55);
  font-size: 24rpx;
}

.topic.selected {
  border-color: #050505;
  background: #050505;
  color: #ffffff;
}

.post-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 18rpx;
}

.post-tag {
  align-self: flex-start;
}

.post-title {
  margin-top: 18rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.post-meta,
.post-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: rgba(0, 0, 0, 0.55);
  font-size: 23rpx;
}

.community-sections { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 34rpx; border-bottom: 1rpx solid #e9e2e4; }
.community-sections .community-section { width: 100%; min-height: 76rpx; margin: 0; padding: 12rpx 2rpx 14rpx; border-bottom: 5rpx solid transparent; border-radius: 0; background: #fff; color: #675d60; font-size: 27rpx; line-height: 1.6; }
.community-sections .community-section.selected { border-color: #d389a2; color: #171313; font-weight: 700; }
.topic-row .category-button { width: auto; margin: 0; background: #fff; line-height: 1.5; }
.topic-row .category-button { flex-shrink: 0; }
.topic-row .category-button.selected { background: #050505; }
.official-card { box-shadow: none; }
.official-header, .official-tags { display: flex; align-items: center; gap: 14rpx; }
.official-header { justify-content: space-between; }
.official-badge { background: #171313; color: #fff; }
.official-category, .official-summary { color: #62565a; font-size: 24rpx; }
.official-summary { margin-top: 12rpx; line-height: 1.6; }
.official-header .star-button { flex-shrink: 0; width: 82rpx; min-height: 82rpx; margin: 0; padding: 0; border-radius: 50%; background: #f5f1f2; color: #453a3e; font-size: 43rpx; line-height: 82rpx; }
.official-header .star-button.is-starred { background: #f7dce6; color: #78324d; }

.post-stats {
  margin-top: 14rpx;
  color: #050505;
}

.submission-toolbar { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.submission-toolbar .submission-refresh { width: auto; min-height: 70rpx; margin: 0; padding: 10rpx 4rpx 10rpx 24rpx; background: transparent; color: #78324d; font-size: 24rpx; line-height: 50rpx; }
.submission-toolbar + .post-list { margin-top: 10rpx; }
.submission-card { box-shadow: none; }
.submission-card .submission-toggle { display: block; width: 100%; margin: 0; padding: 0; background: transparent; color: #171313; text-align: left; line-height: 1.5; }
.submission-meta, .submission-topic { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8rpx 14rpx; }
.submission-date, .submission-topic { color: #62565a; font-size: 23rpx; }
.submission-topic { margin-top: 12rpx; }
.submission-toggle .post-title { display: block; margin-top: 14rpx; overflow-wrap: anywhere; }
.submission-status { padding: 5rpx 14rpx; border-radius: 8rpx; background: #eee9eb; color: #51484b; font-size: 23rpx; }
.submission-status.pending { background: #f7e2ea; color: #78324d; }
.submission-status.published { background: #e8f1e9; color: #28543a; }
.submission-status.rejected { background: #f6e7e0; color: #793c28; }
.submission-body { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e9e2e4; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
