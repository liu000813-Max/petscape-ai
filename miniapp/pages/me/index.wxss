.me-heading { display: flex; justify-content: space-between; align-items: center; }
.me-page .settings-button { display: flex; flex-direction: column; align-items: center; gap: 7rpx; width: 90rpx; margin: 0; padding: 10rpx 5rpx 10rpx 24rpx; background: transparent; font-size: 22rpx; line-height: 1.3; color: #555; }
.settings-button image { width: 35rpx; height: 35rpx; }
.identity-card { display: flex; align-items: center; gap: 20rpx; margin-top: 32rpx; padding: 30rpx 24rpx; border: 1rpx solid #e8e8e8; border-radius: 26rpx; }
.owner-mark { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 50%; background: #faedf2; }
.owner-mark image { width: 48rpx; height: 48rpx; }
.owner-mark .owner-photo { width: 100%; height: 100%; border-radius: 50%; }
.identity-copy { flex: 1; min-width: 0; }
.owner-name { display: block; font-size: 33rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.identity-note { display: block; margin-top: 10rpx; font-size: 22rpx; color: #737373; line-height: 1.6; }
.identity-count { flex-shrink: 0; padding-left: 20rpx; border-left: 1rpx solid #ededed; text-align: center; }
.count-number { display: block; font-size: 42rpx; line-height: 1.2; font-weight: 300; }
.count-label { display: block; margin-top: 6rpx; font-size: 20rpx; color: #737373; }
.me-page .text-button { width: auto; margin: 0; padding: 10rpx 0 10rpx 16rpx; background: transparent; color: #555; font-size: 23rpx; line-height: 1.4; }
.text-button text { margin-left: 6rpx; color: #050505; }
.pet-section-actions { display: flex; align-items: center; gap: 8rpx; }
.me-page .add-companion { color: #803c54; }
.pet-stack-shell { overflow: hidden; }
.pet-stack { height: 326rpx; }
.stack-slide { display: flex; align-items: center; justify-content: center; overflow: visible; }
.stack-current { z-index: 1; }
.me-page .companion-card { width: 100%; max-width: 410rpx; margin: 0; padding: 12rpx; box-sizing: border-box; border: 1rpx solid #e0d9dc; border-radius: 24rpx; background: #f6f4f5; color: #171619; text-align: left; line-height: 1.4; transition: transform 280ms ease; }
.stack-previous .companion-card { transform: translateX(16rpx) rotate(-7deg) scale(.89); }
.stack-next .companion-card { transform: translateX(-16rpx) rotate(7deg) scale(.89); }
.stack-current .companion-card { background: #171619; color: #fff; border-color: #171619; }
.stack-current .companion-pressed { transform: scale(.98); }
.companion-portrait { display: flex; align-items: center; justify-content: center; height: 192rpx; overflow: hidden; border-radius: 15rpx; background: #fff; }
.companion-image { width: 100%; height: 100%; }
.companion-fallback { width: 64rpx; height: 64rpx; opacity: .4; }
.companion-caption { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 12rpx 6rpx; }
.companion-copy { flex: 1; min-width: 0; }
.companion-name { display: block; font-size: 30rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.companion-species { display: block; margin-top: 3rpx; font-size: 21rpx; color: #62595e; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.stack-current .companion-species { color: #dfd0d6; }
.companion-arrow { flex: 0 0 36rpx; text-align: center; color: #f2bdd2; font-size: 33rpx; visibility: hidden; }
.stack-current .companion-arrow { visibility: visible; }
@media (prefers-reduced-motion: reduce) {
  .pet-stack-track { transform: none !important; }
  .me-page .companion-card { transition: none; }
}
.pet-placeholder { min-height: 280rpx; display: flex; align-items: center; justify-content: center; }
.me-page .retry-button { width: 300rpx; margin-top: 20rpx; }
.empty-family { padding: 28rpx 20rpx; border: 1rpx dashed #ddd; border-radius: 24rpx; text-align: center; line-height: 1.7; }
.empty-family image { width: 52rpx; height: 52rpx; margin-bottom: 12rpx; }
.empty-family .muted { margin-top: 5rpx; font-size: 24rpx; }
.me-page .empty-family button { margin-top: 24rpx; width: 350rpx; font-size: 25rpx; }
.entry-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.me-page .personal-entry { position: relative; width: 100%; margin: 0; padding: 24rpx; border: 1rpx solid #e8e8e8; border-radius: 24rpx; text-align: left; background: #fff; line-height: 1.4; color: #050505; }
.personal-entry image { display: block; width: 40rpx; height: 40rpx; margin-bottom: 26rpx; }
.entry-title { display: block; font-size: 29rpx; font-weight: 600; }
.entry-note { display: block; margin-top: 8rpx; font-size: 21rpx; color: #777; }
.entry-arrow { position: absolute; top: 21rpx; right: 24rpx; font-size: 30rpx; }
.me-page .habitat-entry { background: #faf7f8; border-color: #f0e5e9; }
.suggestion-card { padding: 30rpx; background: #f6f6f3; border-radius: 24rpx; }
.suggestion-tag { display: inline-block; padding: 6rpx 13rpx; border-radius: 8rpx; background: #f5dce5; color: #6d4352; font-size: 20rpx; }
.suggestion-title { margin-top: 21rpx; font-size: 40rpx; line-height: 1.4; font-weight: 300; }
.suggestion-note { margin-top: 15rpx; font-size: 23rpx; line-height: 1.6; color: #737373; }
.me-page .suggestion-link { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 21rpx 0 0; margin-top: 23rpx; border-top: 1rpx solid #dededb; border-radius: 0; background: transparent; color: #050505; font-size: 24rpx; line-height: 1.5; }
.suggestion-link text { font-size: 30rpx; }
.me-signature { margin-top: 36rpx; font-size: 20rpx; text-align: center; color: #999; letter-spacing: 1rpx; }
