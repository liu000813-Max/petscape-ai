<page-meta page-style="{{activeModal ? 'overflow: hidden;' : ''}}" />
<view class="page tab-page home-page" aria-hidden="{{!!activeModal}}">
  <image class="brand-logo" src="/assets/petscape-logo.png" mode="widthFix" />
  <view wx:if="{{mockMode}}" class="badge">演示模式 · 示例内容与服务</view>
  <view class="eyebrow">PETSCAPE HABITAT</view>
  <view class="title"><view>给每一只宠物，</view><view>一处合适的宠境。</view></view>
  <view class="subtitle">记录宠物档案，查找养护知识，把每天的照料留在这里。</view>

  <view wx:if="{{!pet && !loading && !loadError}}" class="hero-card" bindtap="openCare">
    <view class="hero-orbit orbit-one"></view>
    <view class="hero-orbit orbit-two"></view>
    <view class="hero-copy">
      <text class="hero-label">PETSCAPE DAILY CARE</text>
      <text class="hero-title">记录宠物的每一天</text>
      <text class="hero-note">喂食 · 饮水 · 清洁 · 体重 · 观察</text>
    </view>
    <view class="hero-arrow">→</view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在读取你的宠物空间</view>
  <view wx:elif="{{loadError}}" class="empty card error-state">
    <view class="empty-title">{{loadErrorTitle}}</view>
    <view class="muted">{{loadError}}</view>
    <view class="muted error-detail">{{loadErrorDetail}}</view>
    <button class="secondary-button section" bindtap="loadSummary">重试读取</button>
  </view>
  <view wx:elif="{{pet}}" class="pet-family section">
    <view class="section-head">
      <view><text class="section-title">我的宠物家庭</text><text class="family-count">{{petCount}} 位成员</text></view>
      <button class="text-button" disabled="{{weightSaving || careSaving}}" data-path="/pages/pet-edit/index" bindtap="openAction">＋ 添加</button>
    </view>
    <view class="pet-carousel-shell">
      <swiper wx:if="{{!weightSaving && !careSaving && !activeModal}}" class="pet-carousel" current="{{petIndex}}" circular="{{petCount > 2}}" previous-margin="{{petCount > 1 ? '220rpx' : '0rpx'}}" next-margin="{{petCount > 1 ? '220rpx' : '0rpx'}}" duration="280" bindchange="onPetSwipe" aria-label="左右滑动切换宠物，点头像查看档案">
        <swiper-item wx:for="{{pets}}" wx:key="id" class="pet-slide {{selectedPetId === item.id ? 'is-current' : ''}}">
          <button class="carousel-pet" data-id="{{item.id}}" bindtap="openPetProfile" disabled="{{weightSaving || careSaving}}" aria-label="查看{{item.name}}的档案">
            <view class="carousel-avatar"><image wx:if="{{item.avatarUrl}}" class="carousel-image" src="{{item.avatarUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onAvatarError" /><text wx:else>{{item.speciesEmoji}}</text></view>
            <text class="carousel-name">{{item.name}}</text>
            <text class="carousel-species">{{item.speciesLabel}}</text>
          </button>
        </swiper-item>
      </swiper>
      <view wx:else class="pet-carousel carousel-saving is-current">
        <view class="carousel-pet">
          <view class="carousel-avatar"><image wx:if="{{pet.avatarUrl}}" class="carousel-image" src="{{pet.avatarUrl}}" mode="aspectFill" data-id="{{pet.id}}" binderror="onAvatarError" /><text wx:else>{{pet.speciesEmoji}}</text></view>
          <text class="carousel-name">{{pet.name}}</text><text class="carousel-species">{{pet.speciesLabel}}</text>
        </view>
      </view>
    </view>
    <view class="carousel-caption"><text>{{weightSaving || careSaving ? '正在保存记录 · 暂停切换' : (petCount > 1 ? '左右滑动切换 · 点头像查看档案' : '点头像查看宠物档案')}}</text><text class="carousel-counter">{{petIndex + 1}} / {{petCount}}</text></view>
    <button class="device-card card device-empty" bindtap="openDeviceModal" disabled="{{weightSaving || careSaving}}" aria-label="为{{pet.name}}添加温湿度设备，尚未连接">
      <view><text class="device-title">宠境环境</text><text class="device-subtitle">尚未连接温湿度设备</text></view>
      <view class="device-add"><view class="device-plus">＋</view><text>添加设备</text></view>
    </button>
  </view>
  <view wx:else class="empty card" bindtap="openPet">
    <view class="empty-title">先建立一份宠物档案</view>
    <view class="muted">从物种、体型和习性开始，照顾好它的每一天</view>
  </view>

  <view wx:if="{{pet}}" class="section weight-section">
    <view class="section-head">
      <view><text class="section-title">日常记录</text><text class="weight-pet-tag">{{pet.name}}</text></view>
    </view>
    <view class="daily-grid">
      <view class="daily-card weight-card card">
        <view class="daily-card-heading"><text>体重记录</text><text class="daily-card-tag">g</text></view>
        <view wx:if="{{weightLoading}}" class="daily-empty">正在读取</view>
        <view wx:elif="{{weightError}}" class="daily-empty">暂未加载</view>
        <block wx:elif="{{latestWeight}}">
          <view class="compact-weight"><text class="compact-number">{{latestWeight.displayValue}}</text><text class="compact-unit">g</text></view>
          <view class="compact-change">{{weightChange ? '比上次 ' + weightChange : '最近一次体重'}}</view>
          <view class="chart-tabs">
            <button class="chart-tab {{weightChartMode === 'bar' ? 'active' : ''}}" data-mode="bar" bindtap="setChartMode" aria-pressed="{{weightChartMode === 'bar'}}">柱状</button>
            <button class="chart-tab {{weightChartMode === 'line' ? 'active' : ''}}" data-mode="line" bindtap="setChartMode" aria-pressed="{{weightChartMode === 'line'}}">折线</button>
          </view>
          <view wx:if="{{weightChartMode === 'bar'}}" class="compact-bar-chart" aria-label="最近{{weightCount}}次体重柱状图，单位克">
            <view wx:for="{{weightHistory}}" wx:key="id" class="compact-bar-track"><view class="compact-bar {{item.isLatest ? 'latest' : ''}}" style="height:{{item.height}}%;"></view></view>
          </view>
          <view wx:else class="compact-line-chart" aria-label="最近{{weightCount}}次体重折线图，单位克">
            <view wx:for="{{weightLineSegments}}" wx:key="id" class="chart-line-segment" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg);"></view>
            <view wx:for="{{weightLinePoints}}" wx:key="id" class="chart-line-point" style="left:{{item.x}}rpx;top:{{item.y}}rpx;"></view>
          </view>
          <view class="compact-chart-dates {{weightCount === 1 ? 'single' : ''}}">
            <text wx:if="{{weightCount > 1}}">{{firstWeightDate}}</text><text>{{latestWeight.date}}</text>
          </view>
          <text class="daily-time">{{latestWeight.time}}</text>
        </block>
        <view wx:else class="daily-empty"><view class="weight-empty-mark">g</view><text>近期暂无可显示的体重</text></view>
        <button class="daily-add" disabled="{{weightSaving || careSaving}}" bindtap="openWeightModal">＋ 记体重</button>
      </view>
      <view class="daily-card feeding-card card">
        <view class="daily-card-heading"><text>喂食记录</text><text class="daily-card-tag">食</text></view>
        <view wx:if="{{weightLoading}}" class="daily-empty">正在读取</view>
        <view wx:elif="{{weightError}}" class="daily-empty">暂未加载</view>
        <view wx:elif="{{latestFeeding}}" class="feeding-content">
          <text class="feeding-value">{{latestFeeding.displayValue}}</text><text class="daily-time">{{latestFeeding.time}}</text>
          <text wx:if="{{latestFeeding.note}}" class="feeding-note">{{latestFeeding.note}}</text>
          <view wx:for="{{earlierFeedings}}" wx:key="id" class="feeding-earlier-item"><text>{{item.shortTime}}</text><text>{{item.displayValue}}</text></view>
        </view>
        <view wx:else class="daily-empty"><view class="weight-empty-mark">食</view><text>近期暂无喂食记录</text></view>
        <button class="daily-add" data-kind="喂食" disabled="{{weightSaving || careSaving}}" bindtap="openCareModal">＋ 记喂食</button>
      </view>
    </view>
    <view wx:if="{{weightError}}" class="records-error"><text>{{weightError}}</text><text class="error-detail">{{weightDiagnostic}}</text><button class="secondary-button" disabled="{{weightSaving || careSaving}}" bindtap="loadWeights">重试读取记录</button></view>
    <view wx:if="{{weightNotice}}" class="weight-notice">{{weightNotice}}</view>
    <view wx:if="{{recordNotice}}" class="weight-notice">{{recordNotice}}</view>
    <view class="weight-footnote">从最多 100 条近期养护中提取：体重最多 7 次，喂食最多 3 次。</view>
    <view class="care-puzzle">
      <button wx:for="{{careKinds}}" wx:key="kind" class="care-tile" data-kind="{{item.kind}}" bindtap="openCareModal" disabled="{{weightSaving || careSaving}}"><view class="care-mark">{{item.mark}}</view><view class="care-tile-copy"><text class="care-tile-title">{{item.kind}}</text><text class="care-tile-hint">{{item.hint}}</text></view><text class="care-tile-plus">＋</text></button>
    </view>
    <button class="care-history-link" bindtap="openCare" disabled="{{weightSaving || careSaving}}">查看养护历史与提醒 →</button>
  </view>

  <view wx:elif="{{!loading && !loadError}}" class="section">
    <view class="section-head">
      <text class="section-title">现在开始</text>
    </view>
    <view class="grid-2">
      <view wx:for="{{quickActions}}" wx:key="title" class="action-card {{item.tone}}" data-path="{{item.path}}" bindtap="openAction">
        <text class="action-title">{{item.title}}</text>
        <text class="action-note">{{item.note}}</text>
        <text class="action-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">给养宠人的一页</text>
      <text class="section-link" bindtap="openAction" data-path="/pages/knowledge/index">全部知识 →</text>
    </view>
    <view wx:for="{{highlights}}" wx:key="title" class="highlight-card card">
      <text class="badge">{{item.tag}}</text>
      <text class="highlight-title">{{item.title}}</text>
      <text class="muted">{{item.note}}</text>
    </view>
  </view>
</view>

<view wx:if="{{activeModal}}" class="modal-mask {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px">
  <view class="modal-backdrop" bindtap="closeModal" catchtouchmove="stopTouch"></view>
  <view class="record-modal" role="dialog" aria-modal="true">
    <view class="modal-handle"></view>
    <view class="modal-heading"><view><text class="modal-kicker">{{modalPetName}} 的日常</text><text class="modal-title">{{activeModal === 'weight' ? '记录体重' : (activeModal === 'care' ? careKind + '记录' : '添加设备')}}</text></view><button class="modal-close" bindtap="closeModal" disabled="{{weightSaving || careSaving}}" aria-label="关闭弹窗">×</button></view>
    <scroll-view scroll-y="{{true}}" class="modal-scroll">
      <view wx:if="{{activeModal === 'weight'}}" class="modal-body">
        <view class="weight-input-label">本次体重</view>
        <view class="weight-input-row">
          <input class="weight-input" type="digit" maxlength="16" value="{{weightInput}}" bindinput="onWeightInput" placeholder="输入体重" disabled="{{weightSaving}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" aria-label="{{modalPetName}}的体重" />
          <view class="weight-units">
            <button class="unit-button {{weightUnit === 'g' ? 'is-active' : ''}}" data-unit="g" bindtap="onWeightUnit" disabled="{{weightSaving}}">g</button>
            <button class="unit-button {{weightUnit === 'kg' ? 'is-active' : ''}}" data-unit="kg" bindtap="onWeightUnit" disabled="{{weightSaving}}">kg</button>
          </view>
        </view>
        <view class="weight-range-hint">大于 0，最多三位小数，上限 1000 kg。保存时间为当前时间。</view>
        <view wx:if="{{weightNotice}}" class="weight-notice">{{weightNotice}}</view><view wx:if="{{weightError}}" class="weight-notice">{{weightError}}<view class="error-detail">{{weightDiagnostic}}</view></view>
        <button wx:if="{{weightUnconfirmed || weightError}}" class="secondary-button weight-retry" disabled="{{weightSaving || weightLoading}}" bindtap="loadWeights">刷新记录，再核对</button>
        <button class="primary-button modal-save" loading="{{weightSaving}}" disabled="{{weightSaving || weightLoading || weightUnconfirmed || weightError}}" bindtap="saveWeight">保存体重</button>
      </view>
      <view wx:elif="{{activeModal === 'care'}}" class="modal-body">
        <view wx:if="{{careKind === '喂食'}}">
          <view class="weight-input-label">食物与食量 · 选填</view>
          <input class="care-value-input" maxlength="200" value="{{careValue}}" bindinput="onCareValue" placeholder="例如：蟋蟀 2 只、主粮 5 g" disabled="{{careSaving}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
        </view>
        <view class="weight-input-label">{{careKind === '生病' ? '症状与观察 · 必填' : '备注 · 选填'}}</view>
        <textarea class="care-note-input" maxlength="500" value="{{careNote}}" bindinput="onCareNote" placeholder="{{careKind === '生病' ? '记录发现的症状、食欲或行为变化' : '记录今天的照料情况'}}" disabled="{{careSaving}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
        <view class="weight-range-hint">{{careKind === '生病' ? '仅记录你的观察，不生成疾病诊断。保存时间为当前时间。' : '确认后记录本次照料，保存时间为当前时间。'}}</view>
        <view wx:if="{{careNotice}}" class="weight-notice">{{careNotice}}</view><view wx:if="{{weightError}}" class="weight-notice">{{weightError}}<view class="error-detail">{{weightDiagnostic}}</view></view>
        <view wx:if="{{careUnconfirmed || careLatest}}" class="recent-care"><text>最近一次{{careKind}}</text><block wx:if="{{careLatest}}"><text>{{careLatest.time}} · {{careLatest.displayValue}}</text><text wx:if="{{careLatest.note}}">{{careLatest.note}}</text></block><text wx:else>近期记录中尚未读取到本类记录。</text></view>
        <button wx:if="{{careUnconfirmed || weightError}}" class="secondary-button weight-retry" disabled="{{careSaving || weightLoading}}" bindtap="refreshCareRecords">刷新记录，再核对</button>
        <button class="primary-button modal-save" loading="{{careSaving}}" disabled="{{careSaving || weightLoading || careUnconfirmed || weightError}}" bindtap="saveCareRecord">确认记录{{careKind}}</button>
      </view>
      <view wx:else class="modal-body device-modal-body">
        <view class="device-plus large">＋</view>
        <text class="device-modal-title">设备配对暂未开放</text>
        <text class="device-modal-note">目前没有连接温湿度设备。连接设备后，可在首页查看温度、湿度和在线状态。</text>
        <button class="primary-button modal-save" bindtap="closeModal">知道了</button>
      </view>
    </scroll-view>
  </view>
</view>
