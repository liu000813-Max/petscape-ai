<page-meta page-style="{{activeModal ? 'overflow: hidden;' : ''}}" />
<import src="../../templates/quantity-wheel.wxml" />
<template name="daily-amount">
  <view class="compact-weight"><text class="compact-number">{{chart.latest.displayValue}}</text><text class="compact-unit">g</text></view>
  <view class="compact-change">{{chart.change ? '比上次 ' + chart.change : (kind === '体重' ? '最近一次体重' : '最近一次有克数的喂食')}}</view>
  <view class="chart-tabs">
    <button class="chart-tab {{mode === 'bar' ? 'active' : ''}}" data-kind="{{kind}}" data-mode="bar" bindtap="setChartMode" aria-pressed="{{mode === 'bar'}}">柱状</button>
    <button class="chart-tab {{mode === 'line' ? 'active' : ''}}" data-kind="{{kind}}" data-mode="line" bindtap="setChartMode" aria-pressed="{{mode === 'line'}}">折线</button>
  </view>
  <view wx:if="{{mode === 'bar'}}" class="compact-bar-chart" aria-label="最近{{chart.count}}次{{kind}}柱状图，单位克">
    <view wx:for="{{chart.history}}" wx:key="id" class="compact-bar-track"><view class="compact-bar {{item.isLatest ? 'latest' : ''}}" style="height:{{item.height}}%;"></view></view>
  </view>
  <view wx:else class="compact-line-chart" aria-label="最近{{chart.count}}次{{kind}}折线图，单位克">
    <view wx:for="{{chart.segments}}" wx:key="id" class="chart-line-segment" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg);"></view>
    <view wx:for="{{chart.points}}" wx:key="id" class="chart-line-point" style="left:{{item.x}}rpx;top:{{item.y}}rpx;"></view>
  </view>
  <view class="compact-chart-dates {{chart.count === 1 ? 'single' : ''}}">
    <text wx:if="{{chart.count > 1}}">{{chart.firstDate}}</text><text>{{chart.latest.date}}</text>
  </view>
  <text class="daily-time">{{chart.latest.time}}</text>
</template>
<view wx:if="{{brandLaunching}}" class="brand-launch" role="status" aria-label="正在打开 PETSCAPE 宠境">
  <image class="brand-launch-logo" src="/assets/petscape-logo.png" mode="widthFix" />
  <view class="brand-launch-track" aria-hidden="true"><view class="brand-launch-fill"></view></view>
</view>
<view wx:else class="page tab-page home-page" aria-hidden="{{!!activeModal}}">
  <view wx:if="{{pet}}" class="home-greeting">
    <text class="home-greeting-title">{{greeting}}</text>
    <image class="brand-logo" src="/assets/petscape-logo.png" mode="widthFix" />
  </view>
  <image wx:else class="brand-logo" src="/assets/petscape-logo.png" mode="widthFix" />
  <view wx:if="{{mockMode}}" class="badge">演示模式 · 示例内容与服务</view>
  <block wx:if="{{!pet && !loading && !loadError}}">
    <view class="eyebrow">PETSCAPE HABITAT</view>
    <view class="title"><view>给每一只宠物，</view><view>一处合适的宠境。</view></view>
    <view class="subtitle">记录宠物档案，查找养护知识，把每天的照料留在这里。</view>
  </block>

  <view wx:if="{{loading && !pet}}" class="loading">正在读取你的宠物空间</view>
  <view wx:elif="{{loadError}}" class="empty card error-state">
    <view class="empty-title">{{loadErrorTitle}}</view>
    <view class="muted">{{loadError}}</view>
    <view class="muted error-detail">{{loadErrorDetail}}</view>
    <button class="secondary-button section" bindtap="loadSummary">重试读取</button>
  </view>
  <view wx:elif="{{pet}}" class="pet-family">
    <view class="family-portrait">
      <view class="section-head">
        <view><text class="section-title">我的宠物家庭</text><text class="family-count">{{petCount}} 位成员</text></view>
        <button class="text-button" disabled="{{weightSaving || careSaving}}" data-path="/pages/pet-edit/index" bindtap="openAction">＋ 添加</button>
      </view>
      <view class="pet-carousel-shell">
        <view class="pet-carousel-track" style="{{petSlideTransform}}">
          <swiper wx:if="{{!weightSaving && !careSaving && !activeModal}}" class="pet-carousel" current="{{petIndex}}" circular="{{petCount > 2}}" previous-margin="{{(petCount > 1 ? petPreviewMargin : 0) + 'rpx'}}" next-margin="{{(petCount > 1 ? petPreviewMargin : 0) + 'rpx'}}" duration="{{petSliding ? 0 : petSlideDuration}}" disable-touch="{{petSliding || loading}}" bindchange="onPetSwipe" aria-label="左右滑动或点两侧头像切换宠物，点中间头像查看详情">
            <swiper-item wx:for="{{pets}}" wx:key="id" class="pet-slide {{selectedPetId === item.id ? 'is-current' : ''}}">
              <button class="carousel-pet" data-id="{{item.id}}" bindtap="onPetAvatarTap" disabled="{{weightSaving || careSaving}}" aria-label="{{selectedPetId === item.id ? '查看' + item.name + '的详情' : '切换到' + item.name}}" hover-class="portrait-pressed" hover-start-time="20" hover-stay-time="80">
                <view class="carousel-avatar"><image wx:if="{{item.avatarUrl}}" class="carousel-image" src="{{item.avatarUrl}}" mode="aspectFill" data-id="{{item.id}}" binderror="onAvatarError" /><text wx:else>{{item.speciesEmoji}}</text></view>
                <text class="carousel-name">{{item.name}}</text>
                <text class="carousel-species">{{item.speciesLabel}}</text>
              </button>
            </swiper-item>
          </swiper>
          <view wx:else class="pet-carousel carousel-saving is-current">
            <view class="carousel-pet">
              <view class="carousel-avatar"><image wx:if="{{pet.avatarUrl}}" class="carousel-image" src="{{pet.avatarUrl}}" mode="aspectFill" data-id="{{pet.id}}" binderror="onAvatarError" /><text wx:else>{{pet.speciesEmoji}}</text></view>
              <text class="carousel-name">{{pet.name}}</text><text class="carousel-species">{{pet.speciesLabel}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="carousel-caption"><text wx:if="{{weightSaving || careSaving}}">正在保存记录 · 暂停切换</text><text class="carousel-counter">{{petIndex + 1}} / {{petCount}}</text></view>
    </view>
    <button class="device-card card device-empty" bindtap="openDevice" disabled="{{loading || petSliding || weightSaving || careSaving}}" aria-label="为{{pet.name}}添加温湿度设备，尚未连接">
      <view class="device-summary"><text class="device-title">宠境环境</text><text class="device-subtitle">设备未连接</text></view>
      <view class="device-add"><view class="device-plus">＋</view><text>添加设备</text></view>
    </button>
  </view>
  <button wx:else class="primary-button first-pet-button" data-path="/pages/pet-edit/index" bindtap="openAction">＋ 添加第一只宠物</button>

  <view wx:if="{{pet}}" class="section weight-section">
    <view class="section-head">
      <view><text class="section-title">日常记录</text><text class="weight-pet-tag">{{pet.name}}</text></view>
    </view>
    <view class="daily-grid">
      <view class="daily-card weight-card card">
        <view class="daily-card-heading"><text>体重记录</text></view>
        <button class="daily-add" disabled="{{loading || petSliding || weightSaving || careSaving}}" bindtap="openWeightModal" hover-class="daily-add-pressed" hover-start-time="20" hover-stay-time="80">＋ 记体重</button>
        <view wx:if="{{weightLoading && !weightChart.latest}}" class="daily-empty">正在读取</view>
        <view wx:elif="{{weightError}}" class="daily-empty">暂未加载</view>
        <template wx:elif="{{weightChart.latest}}" is="daily-amount" data="{{chart: weightChart, mode: weightChartMode, kind: '体重'}}" />
        <view wx:else class="daily-empty"><view class="weight-empty-mark">g</view><text>近期暂无可显示的体重</text></view>
      </view>
      <view class="daily-card feeding-card card">
        <view class="daily-card-heading"><text>喂食记录</text></view>
        <button class="daily-add" data-kind="喂食" disabled="{{loading || petSliding || weightSaving || careSaving}}" bindtap="openCareModal" hover-class="daily-add-pressed" hover-start-time="20" hover-stay-time="80">＋ 记喂食</button>
        <view wx:if="{{weightLoading && !feedingChart.latest && !latestFeeding}}" class="daily-empty">正在读取</view>
        <view wx:elif="{{weightError}}" class="daily-empty">暂未加载</view>
        <block wx:else>
          <view wx:if="{{latestFeeding && latestFeeding.id !== feedingChart.latest.id}}" class="latest-feeding">
            <text class="latest-feeding-label">最近一次喂食</text>
            <text class="feeding-legacy-summary">{{latestFeeding.value || latestFeeding.note || latestFeeding.displayValue}}</text>
            <text class="daily-time">{{latestFeeding.time}} · 未单独记录克数</text>
          </view>
          <template wx:if="{{feedingChart.latest}}" is="daily-amount" data="{{chart: feedingChart, mode: feedingChartMode, kind: '喂食'}}" />
          <view wx:elif="{{!latestFeeding}}" class="daily-empty">近期暂无喂食记录</view>
        </block>
      </view>
    </view>
    <view wx:if="{{weightError}}" class="records-error"><text>{{weightError}}</text><text class="error-detail">{{weightDiagnostic}}</text><button class="secondary-button" disabled="{{loading || petSliding || weightSaving || careSaving}}" bindtap="loadWeights">重试读取记录</button></view>
    <view wx:if="{{weightNotice && !activeModal}}" class="weight-notice record-feedback">
      <view wx:if="{{weightNotice === '体重已保存'}}" class="record-check" aria-hidden="true"></view><text>{{weightNotice}}</text>
    </view>
    <view wx:if="{{recordNotice && !activeModal}}" class="weight-notice record-feedback">
      <view class="record-check" aria-hidden="true"></view><text>{{recordNotice}}</text>
    </view>
    <view class="weight-footnote">从最近 100 条养护记录中，分别展示最多 7 次有明确重量的记录。</view>
    <view class="care-puzzle">
      <button wx:for="{{careKinds}}" wx:key="kind" class="care-tile" data-kind="{{item.kind}}" bindtap="openCareModal" disabled="{{loading || petSliding || weightSaving || careSaving}}" hover-class="care-tile-pressed" hover-start-time="20" hover-stay-time="80">
        <view class="care-mark"><image class="care-icon" src="/assets/care-{{item.icon}}.png" mode="aspectFit" aria-hidden="true" /></view>
        <view class="care-tile-copy"><text class="care-tile-title">{{item.kind}}</text><text class="care-tile-hint">{{item.hint}}</text></view>
        <text class="care-tile-plus" aria-hidden="true">＋</text>
      </button>
    </view>
    <button class="care-history-link" bindtap="openCare" disabled="{{loading || petSliding || weightSaving || careSaving}}">查看养护历史与提醒 →</button>
  </view>

  <view wx:elif="{{!loading && !loadError}}" class="section">
    <view class="section-head">
      <text class="section-title">现在开始</text>
    </view>
    <view class="grid-2">
      <view wx:for="{{quickActions}}" wx:key="title" class="action-card {{item.tone}}" data-path="{{item.path}}" bindtap="openAction">
        <text class="action-title">{{item.title}}</text>
        <text class="action-note">{{item.note}}</text>
        <text class="action-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">给养宠人的一页</text>
      <text class="section-link" bindtap="openAction" data-path="/pages/knowledge/index">查看官方帖 →</text>
    </view>
    <view wx:for="{{highlights}}" wx:key="title" class="highlight-card card">
      <text class="badge">{{item.tag}}</text>
      <text class="highlight-title">{{item.title}}</text>
      <text class="muted">{{item.note}}</text>
    </view>
  </view>
</view>

<view wx:if="{{activeModal}}" class="modal-mask {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px">
  <view class="modal-backdrop" bindtap="closeModal" catchtouchmove="stopTouch"></view>
  <view class="record-modal" role="dialog" aria-modal="true">
    <view class="modal-handle"></view>
    <view class="modal-heading"><view><text class="modal-kicker">{{modalPetName}} 的日常</text><text class="modal-title">{{activeModal === 'weight' ? '记录体重' : '记录' + careKind}}</text></view><button class="modal-close" bindtap="closeModal" disabled="{{weightSaving || careSaving}}" aria-label="关闭弹窗">×</button></view>
    <scroll-view scroll-y="{{true}}" class="modal-scroll">
      <view wx:if="{{activeModal === 'weight'}}" class="modal-body">
        <view class="weight-input-label">本次体重</view>
        <view class="weight-input-row">
          <template is="quantity-wheel" data="{{range: quantityRanges[weightUnit], selection: quantitySelection, amount: weightInput, unit: weightUnit, placeholder: '选择体重', label: '选择体重', disabled: weightSaving}}" />
          <view class="weight-units">
            <button class="unit-button {{weightUnit === 'g' ? 'is-active' : ''}}" data-unit="g" bindtap="onWeightUnit" disabled="{{weightSaving}}">g</button>
            <button class="unit-button {{weightUnit === 'kg' ? 'is-active' : ''}}" data-unit="kg" bindtap="onWeightUnit" disabled="{{weightSaving}}">kg</button>
          </view>
        </view>
        <view wx:if="{{weightNotice}}" class="weight-notice">{{weightNotice}}</view><view wx:if="{{weightError}}" class="weight-notice">{{weightError}}<view class="error-detail">{{weightDiagnostic}}</view></view>
        <button wx:if="{{weightUnconfirmed || weightError}}" class="secondary-button weight-retry" disabled="{{weightSaving || weightLoading}}" bindtap="loadWeights">刷新记录，再核对</button>
        <button class="primary-button modal-save" loading="{{weightSaving}}" disabled="{{weightSaving || weightLoading || weightUnconfirmed || weightError}}" bindtap="saveWeight">保存体重</button>
      </view>
      <view wx:elif="{{activeModal === 'care'}}" class="modal-body">
        <view wx:if="{{careKind === '喂食'}}">
          <view class="weight-input-label">本次喂食克数 · 选填</view>
          <view class="weight-input-row">
            <template is="quantity-wheel" data="{{range: quantityRanges.g, selection: quantitySelection, amount: feedingGrams, unit: 'g', placeholder: '选择克数', label: '选择喂食克数', disabled: careSaving}}" />
            <button wx:if="{{feedingGrams}}" class="quantity-clear" bindtap="clearFeedingQuantity" disabled="{{careSaving}}">清除</button>
          </view>
          <view class="weight-range-hint">克数选填。留空仍会保存食物与备注，只在填入克数后计入喂食图表。</view>
          <view class="weight-input-label">食物与份数 · 选填</view>
          <input class="care-value-input" maxlength="200" value="{{careValue}}" bindinput="onCareValue" placeholder="例如 主粮、蟋蟀 2 只" disabled="{{careSaving}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
        </view>
        <view class="weight-input-label">{{careKind === '生病' ? '症状与观察 · 必填' : '备注 · 选填'}}</view>
        <textarea class="care-note-input" maxlength="500" value="{{careNote}}" bindinput="onCareNote" placeholder="{{careKind === '生病' ? '记录发现的症状、食欲或行为变化' : '记录今天的照料情况'}}" disabled="{{careSaving}}" adjust-position="{{false}}" bindkeyboardheightchange="onKeyboardHeightChange" />
        <view class="weight-range-hint">{{careKind === '生病' ? '仅记录你的观察，不生成疾病诊断。保存时间为当前时间。' : '确认后记录本次照料，保存时间为当前时间。'}}</view>
        <view wx:if="{{careNotice}}" class="weight-notice">{{careNotice}}</view><view wx:if="{{weightError}}" class="weight-notice">{{weightError}}<view class="error-detail">{{weightDiagnostic}}</view></view>
        <view wx:if="{{careUnconfirmed || careLatest}}" class="recent-care"><text>最近一次{{careKind}}</text><block wx:if="{{careLatest}}"><text>{{careLatest.time}} · {{careLatest.displayValue}}</text><text wx:if="{{careLatest.note}}" class="recent-care-note">{{careLatest.note}}</text></block><text wx:else>近期记录中尚未读取到本类记录。</text></view>
        <button wx:if="{{careUnconfirmed || weightError}}" class="secondary-button weight-retry" disabled="{{careSaving || weightLoading}}" bindtap="refreshCareRecords">刷新记录，再核对</button>
        <button class="primary-button modal-save" loading="{{careSaving}}" disabled="{{careSaving || weightLoading || careUnconfirmed || weightError}}" bindtap="saveCareRecord">确认记录{{careKind}}</button>
      </view>
    </scroll-view>
  </view>
</view>
