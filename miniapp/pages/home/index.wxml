<view class="page home-page">
  <image class="brand-logo" src="/assets/petscape-logo.png" mode="widthFix" />
  <view wx:if="{{mockMode}}" class="badge">演示模式 · 示例内容与服务</view>
  <view class="eyebrow">PETSCAPE HABITAT</view>
  <view class="title"><view>给每一只宠物，</view><view>一处合适的栖境。</view></view>
  <view class="subtitle">记录宠物档案，查找养护知识，把每天的照料留在这里。</view>

  <view class="hero-card" bindtap="openCare">
    <view class="hero-orbit orbit-one"></view>
    <view class="hero-orbit orbit-two"></view>
    <view class="hero-copy">
      <text class="hero-label">PETSCAPE DAILY CARE</text>
      <text class="hero-title">记录 {{pet ? pet.name : '你的宠物'}} 的每一天</text>
      <text class="hero-note">喂食 · 饮水 · 清洁 · 体重 · 观察</text>
    </view>
    <view class="hero-arrow">→</view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在读取你的宠物空间</view>
  <view wx:elif="{{pet}}" class="pet-strip card" bindtap="openPet">
    <view class="pet-avatar"><image wx:if="{{pet.speciesImage}}" class="species-image" src="{{pet.speciesImage}}" mode="aspectFill" /><text wx:else>{{pet.speciesEmoji}}</text></view>
    <view class="pet-info">
      <text class="pet-name">{{pet.name}}</text>
      <text class="muted">{{pet.speciesLabel}} · {{pet.breed || '品种待补充'}} · {{pet.environmentNotes || '还没有环境笔记'}}</text>
    </view>
    <text class="section-link">档案 →</text>
  </view>
  <view wx:else class="empty card" bindtap="openPet">
    <view class="empty-title">先建立一份宠物档案</view>
    <view class="muted">从物种、体型和习性开始，照顾好它的每一天</view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">现在开始</text>
    </view>
    <view class="grid-2">
      <view wx:for="{{quickActions}}" wx:key="title" class="action-card {{item.tone}}" data-path="{{item.path}}" bindtap="openAction">
        <text class="action-title">{{item.title}}</text>
        <text class="action-note">{{item.note}}</text>
        <text class="action-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">给养宠人的一页</text>
      <text class="section-link" bindtap="openAction" data-path="/pages/knowledge/index">全部知识 →</text>
    </view>
    <view wx:for="{{highlights}}" wx:key="title" class="highlight-card card">
      <text class="badge">{{item.tag}}</text>
      <text class="highlight-title">{{item.title}}</text>
      <text class="muted">{{item.note}}</text>
    </view>
  </view>
</view>
