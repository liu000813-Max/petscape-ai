.brand-logo {
  display: block;
  width: 300rpx;
  height: auto;
  margin-bottom: 22rpx;
}

.hero-card {
  position: relative;
  min-height: 330rpx;
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #050505;
  color: #ffffff;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 68%;
  padding: 40rpx 34rpx;
}

.hero-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 32rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-note {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  line-height: 1.55;
}

.hero-arrow {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 2;
  font-size: 42rpx;
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
}

.orbit-one {
  top: -130rpx;
  right: -100rpx;
  width: 420rpx;
  height: 420rpx;
}

.orbit-two {
  top: -40rpx;
  right: -10rpx;
  width: 260rpx;
  height: 260rpx;
}

.pet-strip {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.pet-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f7f7f5;
  font-size: 36rpx;
}

.pet-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 700;
}

.pet-info .muted {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action-card {
  position: relative;
  min-height: 210rpx;
  padding: 26rpx;
  border-radius: 18rpx;
}

.action-card.dark {
  background: #050505;
  color: #ffffff;
}

.action-card.light {
  background: #f7f7f5;
  color: #050505;
}

.action-title,
.action-note {
  display: block;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.76;
}

.action-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 34rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.highlight-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.highlight-card .muted {
  margin-top: 8rpx;
  line-height: 1.5;
}

.empty-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.home-page .text-button { margin: 0; padding: 8rpx 0 8rpx 18rpx; min-width: 100rpx; background: transparent; color: #171717; font-size: 25rpx; line-height: 1.6; }
.family-count { display: inline-block; margin-left: 16rpx; color: #686363; font-size: 22rpx; }
.pet-carousel-shell { position: relative; overflow: hidden; }
.pet-carousel { height: 332rpx; }
.carousel-saving { display: flex; align-items: center; justify-content: center; }
.pet-slide { display: flex; align-items: center; justify-content: center; }
.home-page .carousel-pet { display: flex; flex-direction: column; align-items: center; width: 242rpx; margin: 0 auto; padding: 10rpx 0; background: transparent; color: #050505; line-height: 1.4; opacity: 0.38; transform: scale(0.64); transition: transform 280ms ease, opacity 280ms ease; }
.is-current .carousel-pet { opacity: 1; transform: scale(1); }
.carousel-avatar { display: flex; align-items: center; justify-content: center; width: 224rpx; height: 224rpx; padding: 8rpx; overflow: hidden; border: 3rpx solid #eae5e2; border-radius: 50%; background: #faf9f7; font-size: 82rpx; }
.is-current .carousel-avatar { border-color: #d793a8; background: #fdf4f6; }
.carousel-image { width: 100%; height: 100%; border-radius: 50%; }
.carousel-name { display: block; max-width: 240rpx; margin-top: 16rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 28rpx; font-weight: 700; }
.carousel-species { display: block; max-width: 240rpx; margin-top: 4rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #716665; font-size: 22rpx; }
.carousel-caption { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 4rpx 0; color: #746c6a; font-size: 22rpx; line-height: 1.6; }
.carousel-counter { margin-left: 12rpx; color: #8d485d; white-space: nowrap; }
@media (prefers-reduced-motion: reduce) { .home-page .carousel-pet { transition: none; } }
.pet-family .pet-strip { margin-top: 18rpx; padding: 24rpx; box-shadow: none; background: #fafaf8; border-color: #e9e8e5; }
.pet-family .pet-info { min-width: 0; margin-left: 0; }
.weight-pet-tag { display: inline-block; max-width: 220rpx; margin-left: 14rpx; padding: 4rpx 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; border-radius: 999rpx; background: #fbeef2; color: #884157; font-size: 22rpx; }
.weight-card { padding: 30rpx; border-color: #e6e3e2; border-radius: 24rpx; box-shadow: none; }
.weight-eyebrow { color: #77716f; font-size: 18rpx; letter-spacing: 2rpx; }
.weight-summary { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; margin-top: 22rpx; gap: 12rpx; }
.weight-number { font-size: 70rpx; font-weight: 700; letter-spacing: -3rpx; line-height: 1.15; }
.weight-unit { margin-left: 10rpx; font-size: 28rpx; }
.weight-comparison { display: flex; flex-direction: column; padding-bottom: 6rpx; color: #302b2b; font-size: 22rpx; line-height: 1.7; }
.weight-chart { display: flex; gap: 12rpx; margin: 30rpx 0 12rpx; }
.weight-column { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; }
.weight-bar-track { display: flex; width: 100%; height: 150rpx; align-items: flex-end; justify-content: center; border-bottom: 1rpx solid #e6e1df; }
.weight-bar { width: 40%; max-width: 56rpx; min-height: 2rpx; border-radius: 8rpx 8rpx 0 0; background: #e4dedb; }
.weight-bar.is-latest { background: #d78fa4; }
.weight-bar-value { width: 100%; margin-top: 10rpx; text-align: center; word-break: break-all; color: #403b39; font-size: 18rpx; }
.weight-bar-date { margin-top: 4rpx; color: #77716e; font-size: 18rpx; }
.weight-empty { padding: 34rpx 0 24rpx; color: #393334; font-size: 26rpx; text-align: center; line-height: 1.65; }
.weight-empty-mark { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #fbeef2; color: #8b435b; font-size: 34rpx; }
.weight-empty-title { margin-bottom: 8rpx; font-weight: 600; }
.weight-empty .muted { font-size: 24rpx; }
.weight-editor { margin-top: 22rpx; padding-top: 24rpx; border-top: 1rpx solid #eee9e7; }
.weight-input-label { margin-bottom: 14rpx; color: #4c4545; font-size: 24rpx; }
.weight-range-hint { margin-top: 12rpx; color: #77716e; font-size: 20rpx; line-height: 1.6; }
.weight-input-row { display: flex; align-items: center; gap: 18rpx; }
.weight-input { flex: 1; width: 0; min-width: 0; height: 88rpx; padding: 0 22rpx; border: 1rpx solid #ddd7d6; border-radius: 16rpx; background: #fcfbfa; font-size: 32rpx; }
.weight-units { display: flex; flex-shrink: 0; width: 160rpx; padding: 6rpx; border-radius: 16rpx; background: #f3efed; }
.home-page .unit-button { flex: 1; width: 72rpx; min-width: 0; margin: 0; padding: 8rpx 12rpx; border-radius: 12rpx; background: transparent; color: #716766; font-size: 26rpx; line-height: 1.7; }
.home-page .unit-button.is-active { background: #050505; color: #fff; }
.weight-save { width: 100%; margin-top: 18rpx; font-size: 26rpx; }
.weight-notice { margin-top: 18rpx; color: #6c3e4c; font-size: 23rpx; line-height: 1.65; }
.weight-retry { margin-top: 20rpx; }
.weight-footnote { margin-top: 22rpx; color: #77716e; font-size: 20rpx; line-height: 1.6; }
.weight-footer { display: flex; justify-content: space-between; align-items: center; min-height: 70rpx; margin-top: 16rpx; padding-top: 18rpx; border-top: 1rpx solid #eee9e7; font-size: 24rpx; }
.weight-footer-hint { display: block; margin-top: 6rpx; color: #77716e; font-size: 20rpx; }
