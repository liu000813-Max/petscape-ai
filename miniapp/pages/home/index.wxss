@import "../../templates/quantity-wheel.wxss";

.brand-logo {
  display: block;
  width: 300rpx;
  height: auto;
  margin-bottom: 22rpx;
}

.brand-launch { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 36rpx; background: #fff; }
.brand-launch-logo { width: 340rpx; }
.brand-launch-track { width: 176rpx; height: 8rpx; border-radius: 8rpx; background: #f3e7eb; overflow: hidden; }
.brand-launch-fill { width: 46%; height: 100%; background: #bd6687; animation: brand-launch-motion 420ms ease both; }
@keyframes brand-launch-motion { from { transform: translateX(-100%); } to { transform: translateX(220%); } }
.home-greeting { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; padding: 12rpx 0 18rpx; border-bottom: 1rpx solid #eadde2; }
.home-greeting-title { font-size: 44rpx; font-weight: 700; line-height: 1.15; }
.home-greeting .brand-logo { flex: none; width: 168rpx; margin: 0; }
@media (prefers-reduced-motion: reduce) { .brand-launch-fill { animation: none; } }

.action-card {
  position: relative;
  min-height: 210rpx;
  padding: 26rpx;
  border-radius: 18rpx;
}

.action-card.dark {
  background: #050505;
  color: #ffffff;
}

.action-card.light {
  background: #f7f7f5;
  color: #050505;
}

.action-title,
.action-note {
  display: block;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.76;
}

.action-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 34rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.highlight-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.highlight-card .muted {
  margin-top: 8rpx;
  line-height: 1.5;
}

.empty-title { margin-bottom: 8rpx; font-size: 30rpx; font-weight: 700; }
.home-page .text-button { flex-shrink: 0; width: auto; min-height: 72rpx; margin: 0 0 0 auto; padding: 16rpx 0 16rpx 18rpx; background: transparent; color: #171717; font-size: 25rpx; line-height: 1.6; }
.family-portrait {
  padding: 30rpx 0 24rpx;
  border: 1rpx solid #e8e3e1;
  border-top: 6rpx solid #151313;
  border-radius: 24rpx;
  background: #faf8f7;
}
.family-portrait .section-head { margin: 0 24rpx 4rpx; }
.family-portrait .section-title { font-size: 38rpx; }
.family-count { display: inline-block; margin-left: 14rpx; color: #686363; font-size: 22rpx; }
.pet-carousel-shell { position: relative; overflow: hidden; }
.pet-carousel { height: 382rpx; }
.carousel-saving { display: flex; align-items: center; justify-content: center; }
.pet-slide { display: flex; align-items: center; justify-content: center; }
.home-page .carousel-pet { display: flex; flex-direction: column; align-items: center; width: 242rpx; margin: 0 auto; padding: 10rpx 0; background: transparent; color: #050505; line-height: 1.4; opacity: 0.38; transform: scale(0.64); transition: transform 280ms ease, opacity 280ms ease; }
.is-current .carousel-pet { opacity: 1; transform: scale(1); }
.carousel-avatar { display: flex; align-items: center; justify-content: center; width: 234rpx; height: 234rpx; padding: 8rpx; overflow: hidden; border: 3rpx solid #eae5e2; border-radius: 50%; background: #fff; font-size: 82rpx; transition: transform 150ms ease; }
.is-current .carousel-avatar { border-color: #262123; box-shadow: 0 0 0 7rpx #f3dce5; }
.portrait-pressed .carousel-avatar { transform: scale(.965); }
.carousel-image { width: 100%; height: 100%; border-radius: 50%; }
.carousel-name { display: block; max-width: 240rpx; margin-top: 16rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 28rpx; font-weight: 700; }
.is-current .carousel-name { max-width: 222rpx; padding: 4rpx 20rpx; border-radius: 999rpx; background: #151313; color: #fff; font-size: 31rpx; }
.carousel-species { display: block; max-width: 240rpx; margin-top: 4rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #716665; font-size: 22rpx; }
.carousel-caption { display: flex; align-items: center; justify-content: space-between; margin: 0 24rpx; color: #665d5c; font-size: 22rpx; line-height: 1.6; }
.carousel-counter { margin-left: auto; padding-left: 12rpx; color: #8d485d; white-space: nowrap; }
@media (max-height: 680px) {
  .home-page .brand-logo { width: 245rpx; margin-bottom: 12rpx; }
  .family-portrait { padding-top: 14rpx; padding-bottom: 14rpx; }
  .pet-carousel { height: 312rpx; }
  .carousel-avatar { width: 188rpx; height: 188rpx; }
  .home-page .weight-section { margin-top: 24rpx; }
}
.weight-pet-tag { display: inline-block; max-width: 220rpx; margin-left: 14rpx; padding: 4rpx 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; border-radius: 999rpx; background: #fbeef2; color: #884157; font-size: 22rpx; }
.weight-empty-mark { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin: 0 auto 16rpx; border-radius: 50%; background: #fbeef2; color: #8b435b; font-size: 26rpx; }
.weight-input-label { margin-bottom: 14rpx; color: #4c4545; font-size: 24rpx; }
.weight-range-hint { margin-top: 12rpx; color: #77716e; font-size: 20rpx; line-height: 1.6; }
.weight-input-row { display: flex; align-items: center; gap: 18rpx; }
.modal-body .quantity-clear { flex-shrink: 0; width: auto; margin: 0; padding: 8rpx 12rpx; background: transparent; color: #803c54; font-size: 24rpx; line-height: 2; }
.weight-notice { margin-top: 18rpx; color: #6c3e4c; font-size: 23rpx; line-height: 1.65; }
.record-feedback { display: flex; align-items: center; gap: 10rpx; }
.record-check { position: relative; width: 34rpx; height: 34rpx; flex-shrink: 0; border-radius: 50%; background: #f5d8e3; animation: record-check-arrive 230ms ease-out; }
.record-check::after { position: absolute; top: 8rpx; left: 12rpx; width: 7rpx; height: 12rpx; border: solid #6c3e4c; border-width: 0 3rpx 3rpx 0; transform: rotate(45deg); content: ''; }
@keyframes record-check-arrive {
  0% { opacity: .5; transform: scale(.8); }
  65% { transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}
.weight-retry { margin-top: 20rpx; }
.weight-footnote { margin-top: 16rpx; color: #77716e; font-size: 20rpx; line-height: 1.6; }

.pet-family .device-empty { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; width: 100%; min-height: 88rpx; margin: 16rpx 0 0; padding: 10rpx 20rpx; border-radius: 16rpx; box-shadow: none; background: #fafaf8; color: #191717; text-align: left; line-height: 1.5; }
.device-summary { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 12rpx; }
.device-title, .device-subtitle { display: block; }
.device-title { font-size: 28rpx; font-weight: 600; }
.device-subtitle { color: #716b68; font-size: 22rpx; }
.device-add { display: flex; flex-shrink: 0; align-items: center; gap: 12rpx; font-size: 23rpx; }
.device-plus { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 1rpx solid #c9bebc; border-radius: 50%; background: #fff; color: #534a48; font-size: 32rpx; font-weight: 300; }

.daily-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; align-items: stretch; }
.daily-grid .daily-card { display: flex; flex-direction: column; min-width: 0; padding: 22rpx; border-color: #171515; border-radius: 24rpx; box-shadow: none; background: #171515; color: #fff; }
.daily-card-heading { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 28rpx; font-weight: 600; }
.daily-card .weight-empty-mark { background: #392b32; color: #f4c1d3; }
.compact-weight { display: flex; align-items: baseline; gap: 6rpx; margin-top: 22rpx; }
.compact-number { min-width: 0; word-break: break-all; font-size: 46rpx; font-weight: 700; line-height: 1.2; letter-spacing: -1rpx; }
.compact-unit { flex-shrink: 0; color: #e7dce0; font-size: 22rpx; }
.compact-change { flex: 1; min-height: 30rpx; margin-top: 8rpx; color: #d1c7cb; font-size: 20rpx; line-height: 1.5; }
.chart-tabs { display: flex; align-self: flex-start; gap: 4rpx; margin: 18rpx 0 12rpx; padding: 4rpx; border-radius: 12rpx; background: #30292c; }
.chart-tabs .chart-tab { display: flex; align-items: center; justify-content: center; min-height: 64rpx; width: auto; margin: 0; padding: 6rpx 16rpx; border-radius: 8rpx; background: transparent; color: #e7dce0; font-size: 22rpx; line-height: 1.5; }
.chart-tabs .chart-tab.active { background: #f4c1d3; color: #171313; font-weight: 700; }
.compact-bar-chart { display: flex; align-items: flex-end; justify-content: space-around; height: 120rpx; border-bottom: 1rpx solid #6b5c62; }
.compact-bar-track { display: flex; flex: 1; justify-content: center; align-items: flex-end; height: 100%; }
.compact-bar { width: 46%; max-width: 30rpx; min-height: 2rpx; border-radius: 5rpx 5rpx 0 0; background: #9d7e8b; }
.compact-bar.latest, .chart-line-segment { background: #f4c1d3; }
.compact-line-chart { position: relative; width: 244rpx; height: 120rpx; margin: 0 auto; border-bottom: 1rpx solid #6b5c62; background: linear-gradient(to bottom, transparent 49%, #473b41 50%, transparent 51%); }
.chart-line-segment { position: absolute; height: 3rpx; transform-origin: 0 50%; }
.chart-line-point { position: absolute; width: 10rpx; height: 10rpx; border: 2rpx solid #171515; border-radius: 50%; background: #ffd9e6; transform: translate(-50%, -50%); }
.compact-chart-dates { display: flex; justify-content: space-between; margin: 8rpx 0 10rpx; color: #d1c7cb; font-size: 18rpx; }
.compact-chart-dates.single { justify-content: center; }
.daily-time { display: block; margin-top: 8rpx; color: #d1c7cb; font-size: 19rpx; line-height: 1.6; }
.daily-empty { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: 252rpx; padding: 24rpx 0; color: #d1c7cb; font-size: 22rpx; text-align: center; line-height: 1.6; }
.daily-card .daily-add { display: block; width: 100%; min-height: 88rpx; margin: 0 0 12rpx; padding: 18rpx 0; border: 1rpx solid #f4c1d3; border-radius: 16rpx; background: #f4c1d3; color: #171313; font-size: 26rpx; font-weight: 700; line-height: 1.5; transition: opacity 120ms ease, transform 120ms ease; }
.latest-feeding { display: flex; flex-direction: column; gap: 4rpx; margin: 4rpx 0 12rpx; padding-bottom: 10rpx; border-bottom: 1rpx solid #53434a; }
.latest-feeding-label { color: #f4c1d3; font-size: 22rpx; }
.home-page .first-pet-button { margin-top: 28rpx; }
.daily-card .daily-add[disabled] { border-color: #53434a; background: #352d31; color: #bfb1b7; }
.daily-add-pressed { opacity: .83; transform: scale(.97); }
.feeding-legacy-summary { display: -webkit-box; width: 100%; margin-top: 6rpx; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: #fff; word-break: break-all; }
.records-error { display: flex; flex-direction: column; gap: 10rpx; margin-top: 18rpx; padding: 22rpx; border-radius: 18rpx; background: #fbf3f5; color: #71394b; font-size: 24rpx; }
.records-error .secondary-button { width: 100%; margin-top: 8rpx; }
.care-puzzle { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 24rpx; }
.care-puzzle .care-tile { display: flex; align-items: center; gap: 14rpx; width: 100%; min-width: 0; min-height: 138rpx; margin: 0; padding: 20rpx 16rpx; border: 1rpx solid #e7dfdc; border-radius: 22rpx; background: #fcfaf8; color: #1c1716; text-align: left; line-height: 1.4; }
.care-mark { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 16rpx; background: #f8e8ee; }
.care-icon { width: 38rpx; height: 38rpx; transition: transform 150ms ease; }
.care-puzzle .care-tile.care-tile-pressed { border-color: #d78ea6; background: #faedf2; }
.care-tile-pressed .care-icon { transform: translateY(-3rpx) rotate(-6deg); }
.care-tile-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.care-tile-title { font-size: 27rpx; font-weight: 600; }
.care-tile-hint { margin-top: 6rpx; color: #776c65; font-size: 18rpx; }
.care-tile-plus { flex-shrink: 0; color: #85766f; font-size: 25rpx; }
.weight-section .care-history-link { min-height: 72rpx; margin: 12rpx 0 0 auto; padding: 10rpx 0 10rpx 24rpx; background: transparent; color: #655b57; font-size: 24rpx; line-height: 2; }

.modal-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; justify-content: center; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); }
.modal-mask.keyboard-open { padding-bottom: 12rpx; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(24, 16, 18, 0.38); }
.record-modal { position: relative; display: flex; flex-direction: column; width: 100%; max-height: 100%; max-height: min(86vh, 100%); padding: 16rpx 30rpx 30rpx; overflow: hidden; border: 1rpx solid #eee6e3; border-radius: 30rpx; background: #fff; box-shadow: 0 16rpx 80rpx rgba(0, 0, 0, 0.18); }
.modal-handle { flex-shrink: 0; width: 64rpx; height: 6rpx; margin: 0 auto 24rpx; border-radius: 6rpx; background: #ded6d2; }
.modal-heading { display: flex; flex-shrink: 0; align-items: flex-start; justify-content: space-between; gap: 14rpx; margin-bottom: 24rpx; }
.modal-heading > view { min-width: 0; }
.modal-kicker { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8a746e; font-size: 22rpx; }
.modal-title { display: block; margin-top: 8rpx; font-size: 38rpx; font-weight: 600; }
.record-modal .modal-close { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin: 0; padding: 0; border-radius: 50%; background: #f6f2ef; color: #6b5d56; font-size: 40rpx; line-height: 1; }
.modal-scroll { flex: 0 1 auto; min-height: 0; max-height: 60vh; }
.modal-body { padding-bottom: 4rpx; }
.modal-body .weight-input-label { margin-top: 18rpx; }
.modal-body .primary-button, .modal-body .secondary-button { width: 100%; }
.modal-save { margin-top: 28rpx; }
.care-value-input, .care-note-input { width: 100%; padding: 20rpx; border: 1rpx solid #ded5d0; border-radius: 16rpx; background: #fcfaf8; font-size: 27rpx; }
.care-value-input { height: 88rpx; }
.care-note-input { height: 170rpx; }
.recent-care { display: flex; flex-direction: column; gap: 8rpx; margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #f8f4f1; color: #69574e; font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }
.recent-care-note { white-space: pre-wrap; }

@media (prefers-reduced-motion: reduce) {
  .pet-carousel-track { transform: none !important; }
  .home-page .carousel-pet, .carousel-avatar, .care-icon, .daily-card .daily-add { transition: none; }
  .portrait-pressed .carousel-avatar, .care-tile-pressed .care-icon, .daily-add-pressed { transform: none; }
  .record-check { animation: none; }
}
