.brand-logo {
  display: block;
  width: 300rpx;
  height: auto;
  margin-bottom: 22rpx;
}

.hero-card {
  position: relative;
  min-height: 330rpx;
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #050505;
  color: #ffffff;
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 68%;
  padding: 40rpx 34rpx;
}

.hero-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 32rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-note {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  line-height: 1.55;
}

.hero-arrow {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 2;
  font-size: 42rpx;
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 50%;
}

.orbit-one {
  top: -130rpx;
  right: -100rpx;
  width: 420rpx;
  height: 420rpx;
}

.orbit-two {
  top: -40rpx;
  right: -10rpx;
  width: 260rpx;
  height: 260rpx;
}

.pet-strip {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.pet-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f7f7f5;
  font-size: 36rpx;
}

.pet-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 700;
}

.pet-info .muted {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action-card {
  position: relative;
  min-height: 210rpx;
  padding: 26rpx;
  border-radius: 18rpx;
}

.action-card.dark {
  background: #050505;
  color: #ffffff;
}

.action-card.light {
  background: #f7f7f5;
  color: #050505;
}

.action-title,
.action-note {
  display: block;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.76;
}

.action-arrow {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 34rpx;
}

.highlight-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.highlight-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.highlight-card .muted {
  margin-top: 8rpx;
  line-height: 1.5;
}

.empty-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}
