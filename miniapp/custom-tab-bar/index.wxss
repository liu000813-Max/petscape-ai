.tab-dock { position: fixed; z-index: 30; left: 24rpx; right: 24rpx; bottom: 12rpx; bottom: calc(12rpx + env(safe-area-inset-bottom)); }
.tab-bar { display: flex; align-items: stretch; height: 112rpx; padding: 0 8rpx; border: 1rpx solid #e8e8e8; border-radius: 38rpx; background: #fff; box-shadow: 0 8rpx 30rpx rgba(0,0,0,.08); }
.tab-bar .tab-item { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; width: auto; margin: 0; padding: 6rpx 0 12rpx; border: 0; border-radius: 28rpx; color: #777; background: transparent; line-height: 1; }
.tab-item::after { border: 0; }
.tab-symbol { display: flex; align-items: center; justify-content: center; height: 44rpx; }
.tab-icon { width: 38rpx; height: 38rpx; }
.tab-label { margin-top: 8rpx; font-size: 21rpx; line-height: 1.2; }
.tab-bar .is-selected { color: #050505; font-weight: 600; }
.tab-dot { position: absolute; bottom: 7rpx; width: 7rpx; height: 4rpx; border-radius: 4rpx; background: #eea1ba; }
.tab-bar .tab-center { padding-top: 0; overflow: visible; color: #050505; }
.tab-center .tab-symbol { width: 96rpx; height: 96rpx; margin-top: -34rpx; border: 7rpx solid #fff; border-radius: 50%; background: #050505; box-shadow: 0 0 0 2rpx #f3c3d3; }
.tab-center .tab-icon { width: 45rpx; height: 45rpx; }
.tab-center .tab-label { margin-top: 5rpx; }
.tab-center.is-selected .tab-symbol { box-shadow: 0 0 0 4rpx #eaa0b9; }
.tab-pressed { opacity: .6; }
