<view wx:if="{{!hidden}}" class="tab-dock" role="navigation" aria-label="主导航">
  <view class="tab-bar">
    <button wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{selected === item.pagePath ? 'is-selected' : ''}}" data-path="{{item.pagePath}}" bindtap="switchTab" aria-label="{{item.text}}" aria-current="{{selected === item.pagePath ? 'page' : 'false'}}" hover-class="tab-pressed" hover-start-time="20" hover-stay-time="80">
      <view class="tab-symbol">
        <view class="tab-icon-disc">
          <image class="tab-icon" src="/assets/nav-{{item.icon}}{{selected === item.pagePath ? '-white' : '-gray'}}.png" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </button>
  </view>
</view>
