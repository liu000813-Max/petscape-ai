#!/usr/bin/env bash
# PetScape 阿里云 CLI 封装：强制使用项目 .env 凭证，并在执行前断言账号身份。
# 背景：本机 ~/.aliyun/config.json 的全局默认凭证属于用户个人账号（<PERSONAL_CLOUD_ACCOUNT_ID>），
# 裸调 aliyun 会打到错误账号。所有 PetScape 阿里云操作必须经过本脚本。
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$ROOT/.env"
EXPECTED_ACCOUNT="<PROJECT_CLOUD_ACCOUNT_ID>"   # PETSCAPE 主账号

AK=$(grep '^ALIBABA_CLOUD_ACCESS_KEY_ID=' "$ENV_FILE" | cut -d= -f2-)
SK=$(grep '^ALIBABA_CLOUD_ACCESS_KEY_SECRET=' "$ENV_FILE" | cut -d= -f2-)
if [ -z "$AK" ] || [ -z "$SK" ]; then
  echo "tools/aliyun: $ENV_FILE 缺少 ALIBABA_CLOUD_ACCESS_KEY_ID/SECRET" >&2
  exit 1
fi

ACTUAL=$(aliyun sts GetCallerIdentity --access-key-id "$AK" --access-key-secret "$SK" \
  --region cn-hangzhou 2>/dev/null | grep -o '"AccountId": "[0-9]*"' | grep -o '[0-9]*' || true)
if [ "$ACTUAL" != "$EXPECTED_ACCOUNT" ]; then
  echo "tools/aliyun: 账号断言失败——期望 PETSCAPE($EXPECTED_ACCOUNT)，实际 ${ACTUAL:-无法识别}。" >&2
  echo "检查 .env 凭证；禁止回退到全局 aliyun 配置（那是个人账号）。" >&2
  exit 1
fi

exec aliyun "$@" --access-key-id "$AK" --access-key-secret "$SK"
